<UserControl x:Class="OverTranslate.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
             PreviewMouseDown="SettingsPage_PreviewMouseDown">

    <UserControl.Resources>
        <!-- One switchable option: the tick, a glyph, and a name over the sentence explaining it.
             Declared here rather than in the shared dictionary because nothing outside this page
             lays a setting out this way. -->
        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        </Style>
        <Style x:Key="OptionDescription" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
            <Setter Property="Margin"       Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OptionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize"          Value="15"/>
            <Setter Property="Foreground"        Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin"            Value="10,1,10,0"/>
        </Style>
        <!-- The card's heading strip: glyph, title, and room under it before the first setting. -->
        <Style x:Key="CardHeaderRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
        </Style>
        <!-- One shortcut: a glyph, what it does, the combination, and the switch. Filled rather
             than outlined so a row reads as one thing to act on, against the card that holds it. -->
        <Style x:Key="HotkeyRow" TargetType="Border" BasedOn="{StaticResource ToggleRowBorder}">
            <Setter Property="Padding" Value="12,11"/>
        </Style>
        <!-- The same tile 側邊欄 gives a 快速工具, at the larger size this page works in: fill,
             border and a corner radius held to the same fraction of the tile. A shortcut row
             here and the rail row that fires it are the same feature, so the two should not be
             recognisably different objects. See RailQuickToolIcon in SharedStyles. -->
        <Style x:Key="HotkeyRowIcon" TargetType="Border">
            <Setter Property="Width"              Value="34"/>
            <Setter Property="Height"             Value="34"/>
            <Setter Property="CornerRadius"       Value="8"/>
            <Setter Property="Background"         Value="{DynamicResource AppAccentSubtle}"/>
            <Setter Property="BorderBrush"        Value="{DynamicResource AppAccentSubtleHover}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Margin"             Value="0,0,13,0"/>
        </Style>
        <Style x:Key="HotkeyRowGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily"           Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize"             Value="16"/>
            <Setter Property="Foreground"           Value="{DynamicResource AppAccent}"/>
            <Setter Property="HorizontalAlignment"  Value="Center"/>
            <Setter Property="VerticalAlignment"    Value="Center"/>
        </Style>
        <!-- The shortcut boxes are read-only and act as buttons: clicking one starts recording,
             which is why these rows carry no separate record button. -->
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsReadOnly"        Value="True"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip"           Value="{DynamicResource S.Settings.HotkeyRecordTip}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Page header ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource S.Settings.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource S.Settings.Subtitle}"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Settings cards scroll; the auto-save bar below stays put so it is always reachable -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <!-- Two columns rather than one, so the short cards sit beside the tall one they used
                 to be scrolled past. MaxWidth keeps the text readable on a wide window; below it
                 the columns simply narrow, and every card inside wraps rather than clipping.

                 IsSharedSizeScope aligns the label column of the rows that still read
                 label-then-field, so those stay lined up across cards. -->
            <Grid MaxWidth="1120" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════ 快捷鍵 ══════════
                     Order is priority order: a combination claimed by a row above turns the row
                     below off rather than one of the two silently failing to register. See
                     Services/HotkeyBindings. -->
                <Border Grid.Column="0" Grid.Row="0"
                        Style="{StaticResource CardBorder}"
                        Margin="0,0,12,12">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeaderRow}">
                            <TextBlock Text="&#xE765;" Style="{StaticResource CardHeaderIcon}"/>
                            <TextBlock Text="{DynamicResource S.Settings.Hotkeys}"
                                       Style="{StaticResource CardTitle}"/>

                            <!-- What a shortcut may be at all, on the heading rather than in a
                                 panel of its own. It is the same answer for all three rows, and it
                                 is read once and then never again — a card spelling it out sat
                                 above the rows for good, taking the room the rows are in.

                                 Background="Transparent", not left null: a TextBlock with no
                                 background is only hit-testable where the glyph's own strokes are,
                                 so the tooltip would appear over parts of a 13px "i" and nowhere
                                 else. Padding widens that box to something a mouse can find. -->
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Background="Transparent"
                                       Padding="4,2"
                                       Margin="7,1,0,0"
                                       VerticalAlignment="Center"
                                       Cursor="Help">
                                <controls:HoverToolTip.Content>
                                    <!-- Two blocks rather than one string: the second is an example
                                         of the first, and they were two lines in the card this
                                         replaced for the same reason. MaxWidth because a tooltip
                                         given a long sentence otherwise runs the width of the
                                         screen. No Foreground — the tooltip's own is whatever the
                                         system paints its background with. -->
                                    <StackPanel MaxWidth="420">
                                        <TextBlock Text="{DynamicResource S.Settings.HotkeyKinds}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="{StaticResource AppFontSize}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                        <TextBlock Text="{DynamicResource S.Settings.HotkeyKindsExample}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="11"
                                                   Opacity="0.85"
                                                   TextWrapping="Wrap"
                                                   LineHeight="16"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </controls:HoverToolTip.Content>
                            </TextBlock>
                        </StackPanel>

                        <!-- Capture has no on/off tick at all: this is the feature the application
                             is for. Its last column is empty and still here, so the three rows'
                             shortcut boxes end at the same place — see SharedSizeGroup. -->
                        <Border Style="{StaticResource HotkeyRow}">
                            <StackPanel>
                                <Grid>
                                    <!-- The shortcut box grows with the window rather than sitting
                                         at a fixed width: while recording it holds a whole sentence
                                         asking for a key, which no width that also suits a card
                                         beside another card can show in full. MinWidth is on the
                                         column, not the box — a star column will squeeze a child
                                         past its own minimum and clip it, and the rows have to keep
                                         ending at the same place.

                                         The name and description column has no minimum of its own:
                                         it is the one thing here that can give, and at the narrowest
                                         window it has to, or the switch on the end is pushed out of
                                         the card and the row loses a control instead of losing a
                                         line of prose. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyToggle"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource HotkeyRowIcon}">
                                        <Path Style="{StaticResource DrawnMark}"
                                              Data="{StaticResource CaptureMarkGeometry}"
                                              Stroke="{DynamicResource AppAccent}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{DynamicResource S.Settings.CaptureHotkey}"
                                                   Style="{StaticResource OptionTitle}"/>
                                        <TextBlock controls:HighlightedText.Source="{DynamicResource S.Settings.CaptureHotkeyHint}"
                                                   Style="{StaticResource OptionDescription}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34"/>
                                    </StackPanel>

                                    <TextBox Grid.Column="2" x:Name="HotkeyBox"
                                             Style="{StaticResource HotkeyBox}"
                                             PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotFocus="HotkeyBox_GotFocus"
                                             LostFocus="HotkeyBox_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 取詞翻譯. The only feature with no way in but a shortcut, which is why
                             this row is the one place in the interface that names it. -->
                        <Border Style="{StaticResource HotkeyRow}">
                            <StackPanel>
                                <Grid>
                                    <!-- The column widths are the row above this one's, and have to
                                         stay that way: they are what makes the four boxes end at
                                         the same place. See the comment on that row for why the
                                         minimum is on the column rather than the box. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyToggle"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource HotkeyRowIcon}">
                                        <Path Style="{StaticResource DrawnMark}"
                                              Data="{StaticResource QuickLookupMarkGeometry}"
                                              Stroke="{DynamicResource AppAccent}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{DynamicResource S.Settings.QuickLookupHotkey}"
                                                   Style="{StaticResource OptionTitle}"/>
                                        <TextBlock controls:HighlightedText.Source="{DynamicResource S.Settings.QuickLookupHotkeyHint}"
                                                   Style="{StaticResource OptionDescription}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34"/>
                                    </StackPanel>

                                    <TextBox Grid.Column="2" x:Name="QuickLookupHotkeyBox"
                                             Style="{StaticResource HotkeyBox}"
                                             PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotFocus="HotkeyBox_GotFocus"
                                             LostFocus="HotkeyBox_LostFocus"/>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <CheckBox x:Name="QuickLookupHotkeyEnabledCheckBox"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  ToolTip="{DynamicResource S.Settings.HotkeyEnable}"
                                                  Checked="HotkeyEnabled_Toggled"
                                                  Unchecked="HotkeyEnabled_Toggled"/>
                                        <TextBlock x:Name="QuickLookupHotkeyEnabledLabel"
                                                   Style="{StaticResource FieldLabel}"
                                                   MinWidth="56"
                                                   Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- The one thing about this shortcut that the name does not say,
                                     inside the row it is about. -->
                                <StackPanel Orientation="Horizontal" Margin="47,8,0,0">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource S.Settings.QuickLookupHotkeyNote}"
                                               Style="{StaticResource FieldHint}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Translation window. Same editing controls as the capture shortcut and
                             deliberately nothing else: this one opens a window that is already one
                             tray click away, so it is not announced at startup. -->
                        <Border Style="{StaticResource HotkeyRow}">
                            <StackPanel>
                                <Grid>
                                    <!-- The shortcut box grows with the window rather than sitting
                                         at a fixed width: while recording it holds a whole sentence
                                         asking for a key, which no width that also suits a card
                                         beside another card can show in full. MinWidth is on the
                                         column, not the box — a star column will squeeze a child
                                         past its own minimum and clip it, and the rows have to keep
                                         ending at the same place.

                                         The name and description column has no minimum of its own:
                                         it is the one thing here that can give, and at the narrowest
                                         window it has to, or the switch on the end is pushed out of
                                         the card and the row loses a control instead of losing a
                                         line of prose. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyToggle"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource HotkeyRowIcon}">
                                        <TextBlock Text="&#xE737;" Style="{StaticResource HotkeyRowGlyph}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{DynamicResource S.Settings.WindowHotkey}"
                                                   Style="{StaticResource OptionTitle}"/>
                                        <TextBlock controls:HighlightedText.Source="{DynamicResource S.Settings.WindowHotkeyHint}"
                                                   Style="{StaticResource OptionDescription}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34"/>
                                    </StackPanel>

                                    <TextBox Grid.Column="2" x:Name="WindowHotkeyBox"
                                             Style="{StaticResource HotkeyBox}"
                                             PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotFocus="HotkeyBox_GotFocus"
                                             LostFocus="HotkeyBox_LostFocus"/>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <CheckBox x:Name="WindowHotkeyEnabledCheckBox"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  ToolTip="{DynamicResource S.Settings.HotkeyEnable}"
                                                  Checked="HotkeyEnabled_Toggled"
                                                  Unchecked="HotkeyEnabled_Toggled"/>
                                        <!-- Sized for the longer of the two words, so switching one
                                             row does not move the switches on the rows sharing this
                                             column's width. -->
                                        <TextBlock x:Name="WindowHotkeyEnabledLabel"
                                                   Style="{StaticResource FieldLabel}"
                                                   MinWidth="56"
                                                   Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pausing a running session. The only realtime shortcut there is: block
                             framing had one above this until a session started by naming a window on
                             the page, which is not something a shortcut can answer. -->
                        <Border Style="{StaticResource HotkeyRow}">
                            <StackPanel>
                                <Grid>
                                    <!-- The shortcut box grows with the window rather than sitting
                                         at a fixed width: while recording it holds a whole sentence
                                         asking for a key, which no width that also suits a card
                                         beside another card can show in full. MinWidth is on the
                                         column, not the box — a star column will squeeze a child
                                         past its own minimum and clip it, and the rows have to keep
                                         ending at the same place.

                                         The name and description column has no minimum of its own:
                                         it is the one thing here that can give, and at the narrowest
                                         window it has to, or the switch on the end is pushed out of
                                         the card and the row loses a control instead of losing a
                                         line of prose. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*" MinWidth="140"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyToggle"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource HotkeyRowIcon}">
                                        <Path Style="{StaticResource DrawnMark}"
                                              Data="{StaticResource PlayPauseMarkGeometry}"
                                              Stroke="{DynamicResource AppAccent}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{DynamicResource S.Settings.RealtimePauseHotkey}"
                                                   Style="{StaticResource OptionTitle}"/>
                                        <TextBlock controls:HighlightedText.Source="{DynamicResource S.Settings.RealtimePauseHotkeyHint}"
                                                   Style="{StaticResource OptionDescription}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34"/>
                                    </StackPanel>

                                    <TextBox Grid.Column="2" x:Name="RealtimePauseHotkeyBox"
                                             Style="{StaticResource HotkeyBox}"
                                             PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotFocus="HotkeyBox_GotFocus"
                                             LostFocus="HotkeyBox_LostFocus"/>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <CheckBox x:Name="RealtimePauseHotkeyEnabledCheckBox"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  ToolTip="{DynamicResource S.Settings.HotkeyEnable}"
                                                  Checked="HotkeyEnabled_Toggled"
                                                  Unchecked="HotkeyEnabled_Toggled"/>
                                        <!-- Sized for the longer of the two words, so switching one
                                             row does not move the switches on the rows sharing this
                                             column's width. -->
                                        <TextBlock x:Name="RealtimePauseHotkeyEnabledLabel"
                                                   Style="{StaticResource FieldLabel}"
                                                   MinWidth="56"
                                                   Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- When this shortcut does nothing, inside the row it is about
                                     rather than under the three of them: nothing here applies to
                                     the other two. -->
                                <StackPanel Orientation="Horizontal" Margin="47,8,0,0">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource S.Settings.RealtimePauseHotkeyNote}"
                                               Style="{StaticResource FieldHint}"
                                               Margin="0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ══════════ 一般設定 ══════════
                     介面語言 leads the card rather than sitting in 外觀 at the foot of the page: it
                     is the one setting that changes how every other setting reads, so a user who
                     opened this page because they cannot read it finds it without scrolling. -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeaderRow}">
                            <TextBlock Text="&#xE713;" Style="{StaticResource CardHeaderIcon}"/>
                            <TextBlock Text="{DynamicResource S.Settings.General}"
                                       Style="{StaticResource CardTitle}"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource S.Settings.UiLanguage}"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,7"/>
                        <ComboBox x:Name="UiLanguageBox"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedValuePath="Code"
                                  SelectionChanged="UiLanguageBox_SelectionChanged"/>

                        <Border Height="1" Margin="0,14,0,12"
                                Background="{DynamicResource AppSeparator}"/>

                        <!-- 框選完成自動翻譯 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox  Grid.Column="0" x:Name="AutoTranslateCheckBox"
                                       Style="{StaticResource ModernCheckBox}"
                                       VerticalAlignment="Top"
                                       ToolTip="{DynamicResource S.Settings.AutoTranslate}"
                                       Checked="AutoTranslate_Toggled"
                                       Unchecked="AutoTranslate_Toggled"/>
                            <TextBlock Grid.Column="1" Text="&#xE945;" Style="{StaticResource OptionGlyph}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource S.Settings.AutoTranslate}"
                                           Style="{StaticResource OptionTitle}"/>
                                <TextBlock Text="{DynamicResource S.Settings.AutoTranslateCheck}"
                                           Style="{StaticResource OptionDescription}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 開機自動啟動 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox  Grid.Column="0" x:Name="StartupCheckBox"
                                       Style="{StaticResource ModernCheckBox}"
                                       VerticalAlignment="Top"
                                       ToolTip="{DynamicResource S.Settings.Startup}"
                                       Checked="Startup_Toggled"
                                       Unchecked="Startup_Toggled"/>
                            <TextBlock Grid.Column="1" Text="&#xE7E8;" Style="{StaticResource OptionGlyph}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource S.Settings.Startup}"
                                           Style="{StaticResource OptionTitle}"/>
                                <TextBlock Text="{DynamicResource S.Settings.StartupCheck}"
                                           Style="{StaticResource OptionDescription}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 同時儲存到本機. The save-path row travels with this tick rather than
                             standing on its own: it is the same decision, and it is only shown
                             once the box is ticked. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox  Grid.Column="0" Grid.Row="0" x:Name="SaveScreenshotCheckBox"
                                       Style="{StaticResource ModernCheckBox}"
                                       VerticalAlignment="Top"
                                       ToolTip="{DynamicResource S.Settings.SaveScreenshot}"
                                       Checked="SaveScreenshotCheckBox_Toggled"
                                       Unchecked="SaveScreenshotCheckBox_Toggled"/>
                            <TextBlock Grid.Column="1" Grid.Row="0" Text="&#xE91B;" Style="{StaticResource OptionGlyph}"/>
                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="{DynamicResource S.Settings.SaveScreenshot}"
                                           Style="{StaticResource OptionTitle}"/>
                                <TextBlock Text="{DynamicResource S.Settings.SaveScreenshotCheck}"
                                           Style="{StaticResource OptionDescription}"/>
                            </StackPanel>

                            <!-- 儲存位置（僅在開關開啟時顯示）. Indented under the tick it belongs
                                 to rather than starting a row of its own. -->
                            <Grid Grid.Column="2" Grid.Row="1" x:Name="ScreenshotPathRow" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Above the box rather than beside it: this row is already
                                     indented under the tick that owns it, and a second column of
                                     label would leave the path itself too narrow to read. -->
                                <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="{DynamicResource S.Settings.SavePath}"
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,0,0,4"/>
                                <TextBox   Grid.Column="0" Grid.Row="1" x:Name="ScreenshotPathBox"
                                           Style="{StaticResource ModernTextBox}"
                                           IsReadOnly="True"
                                           Cursor="Hand"
                                           Margin="0,0,4,0"
                                           ToolTip="{DynamicResource S.Settings.SavePathTip}"
                                           PreviewMouseLeftButtonDown="ScreenshotPathBox_PreviewMouseLeftButtonDown"/>
                                <Button    Grid.Column="1" Grid.Row="1" x:Name="OpenScreenshotFolderBtn"
                                           Content="📂"
                                           Style="{StaticResource IconButton}"
                                           Height="34"
                                           ToolTip="{DynamicResource S.Settings.OpenFolderTip}"
                                           Click="OpenScreenshotFolderBtn_Click"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════ 翻譯服務設定 ══════════
                     Only the two services that have something to be told. Which service actually
                     translates is deliberately not set here: 文字翻譯 and 即時翻譯 each keep their
                     own choice and save it themselves, so a third selector on this page would claim
                     to speak for both and speak for neither. The services that need nothing are not
                     tiles either — a tile whose only message is "nothing to set" asks to be read
                     and then says nothing. -->
                <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeaderRow}">
                            <TextBlock Text="&#xE774;" Style="{StaticResource CardHeaderIcon}"/>
                            <TextBlock Text="{DynamicResource S.Settings.ServiceSetup}"
                                       Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{DynamicResource S.Settings.ServiceSetupHint}"
                                       Style="{StaticResource FieldHint}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- The tiles are the same width whatever they hold, so the pair reads as
                             two of one thing rather than as a wide one and a narrow one. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ServiceTileBorder}"
                                    Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The square around each mark paints nothing: it is the box
                                         an app icon would occupy, and it is here only so the two
                                         marks are measured against one fixed size rather than
                                         against whatever else is in the row. Without it Uniform has
                                         no height to fit into, and since it only ever shrinks, the
                                         DeepL mark stayed at the 19 units its own file is drawn in.

                                         A visible plate is a different thing and deliberately not
                                         drawn: these are the vendors' logos, and setting them on
                                         tinted tiles turns two recognisable marks into two of this
                                         app's icons. -->
                                    <Grid Grid.Column="0" Grid.Row="0"
                                          Width="48" Height="48"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0">
                                        <Path Data="{StaticResource DeepLMarkGeometry}"
                                              Fill="{DynamicResource AppDeepLMark}"
                                              Stretch="Uniform"
                                              Width="32"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Provider.DeepL}"
                                                   Style="{StaticResource ChoiceTileTitle}"
                                                   FontSize="15"/>
                                        <Border x:Name="DeepLBadge"
                                                Style="{StaticResource ServiceBadgeBorder}"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0">
                                            <TextBlock x:Name="DeepLBadgeText" Style="{StaticResource ServiceBadgeText}"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                            x:Name="DeepLConfigureBtn"
                                            Content="{DynamicResource S.Common.Configure}"
                                            Style="{StaticResource FlatButton}"
                                            Height="34"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Stretch"
                                            Click="ConfigureService_Click"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource ServiceTileBorder}"
                                    Margin="6,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Grid.Row="0"
                                          Width="48" Height="48"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0">
                                        <!-- Wider than the DeepL mark on purpose. That one is a
                                             solid shape that fills its box; this one is thin open
                                             strokes with most of its box empty, and its widest
                                             points are on the diagonal — so matched box widths
                                             leave it looking both smaller and further from the
                                             text. The usual optical correction for an open round
                                             mark against a solid angular one. -->
                                        <Path Data="{StaticResource OpenAiMarkGeometry}"
                                              Fill="{DynamicResource AppOpenAiMark}"
                                              Stretch="Uniform"
                                              Width="36"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Provider.OpenAI}"
                                                   Style="{StaticResource ChoiceTileTitle}"
                                                   FontSize="15"/>
                                        <Border x:Name="OpenAiBadge"
                                                Style="{StaticResource ServiceBadgeBorder}"
                                                HorizontalAlignment="Left"
                                                Margin="0,6,0,0">
                                            <TextBlock x:Name="OpenAiBadgeText" Style="{StaticResource ServiceBadgeText}"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                            x:Name="OpenAiConfigureBtn"
                                            Content="{DynamicResource S.Common.Configure}"
                                            Style="{StaticResource FlatButton}"
                                            Height="34"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Stretch"
                                            Click="ConfigureService_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════ 外觀 ══════════ -->
                <Border Grid.Column="0" Grid.Row="2"
                        Style="{StaticResource CardBorder}"
                        Margin="0,0,12,12">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeaderRow}">
                            <TextBlock Text="&#xE790;" Style="{StaticResource CardHeaderIcon}"/>
                            <TextBlock Text="{DynamicResource S.Settings.Appearance}"
                                       Style="{StaticResource CardTitle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource S.Settings.Theme}"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="LightThemeRadio"
                                             Content="{DynamicResource S.Settings.ThemeLight}"
                                             GroupName="ThemeGroup"
                                             Style="{StaticResource ThemeRadioButton}"
                                             Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="DarkThemeRadio"
                                             Content="{DynamicResource S.Settings.ThemeDark}"
                                             GroupName="ThemeGroup"
                                             Style="{StaticResource ThemeRadioButton}"
                                             Margin="0"
                                             Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════════ 進階設定 ══════════
                     Nothing here is part of translating, and a user who never has a problem to
                     report never needs to read it. -->
                <Border Grid.Column="1" Grid.Row="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeaderRow}">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource CardHeaderIcon}"/>
                            <TextBlock Text="{DynamicResource S.Settings.Advanced}"
                                       Style="{StaticResource CardTitle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox  Grid.Column="0" x:Name="VerboseLoggingCheckBox"
                                       Style="{StaticResource ModernCheckBox}"
                                       VerticalAlignment="Top"
                                       ToolTip="{DynamicResource S.Settings.Logging}"
                                       Checked="VerboseLogging_Toggled"
                                       Unchecked="VerboseLogging_Toggled"/>
                            <TextBlock Grid.Column="1" Text="&#xE9D9;" Style="{StaticResource OptionGlyph}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource S.Settings.LoggingCheck}"
                                           Style="{StaticResource OptionTitle}"/>
                                <TextBlock x:Name="VerboseLoggingHint"
                                           Text="{DynamicResource S.Settings.LoggingHint}"
                                           Style="{StaticResource OptionDescription}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Below the checkbox rather than beside it: the box decides what gets
                             written, these two decide what happens to what was written, and the
                             usual order of that conversation is tick, reproduce, then hand over. -->
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource S.Settings.DiagnosticsHint}"
                                       Style="{StaticResource OptionDescription}"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExportDiagnosticsBtn"
                                        Content="{DynamicResource S.Settings.ExportDiagnostics}"
                                        Style="{StaticResource FlatButton}"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        ToolTip="{DynamicResource S.Settings.ExportDiagnosticsTip}"
                                        Click="ExportDiagnosticsBtn_Click"/>
                                <Button x:Name="OpenLogFolderBtn"
                                        Content="{DynamicResource S.Settings.OpenLogFolder}"
                                        Style="{StaticResource FlatButton}"
                                        Height="34"
                                        Click="OpenLogFolderBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ── Status bar ── -->
        <!-- Settings persist as they change, so there is no save button; this line states
             that contract and flashes a confirmation on each write -->
        <Border Grid.Row="2" Margin="0,12,8,0"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,9">
            <Grid>
                <StackPanel x:Name="AutoSaveHint" Orientation="Horizontal">
                    <TextBlock Text="&#xE945;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource AppAccent}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>
                    <TextBlock Text="{DynamicResource S.Settings.AutoSaveHint}"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           Opacity="0"
                           Foreground="{DynamicResource AppSuccess}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
