<Window x:Class="OverTranslate.Views.Capture.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:OverTranslate.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Room for the shadow to fade out inside the window, which is what this margin is for: a
         blur still carrying opacity when it reaches the window's edge is cut off there, and the cut
         is a straight line — a faint grey rectangle around the bar that reads as a stray border. So
         the margin is at least the blur radius on every side, counted from the shadowed twin below,
         which is itself inset by 2. -->
    <Border Margin="12,10,12,14">
        <Grid>
            <!-- The shadow rides an empty twin of the bar rather than the bar itself. An Effect makes
                 WPF rasterise the element it is set on into an intermediate surface, and ClearType
                 sub-pixel antialiasing cannot run over a surface that may be transparent - so a
                 shadow on the bar quietly dropped every label on it to greyscale antialiasing, which
                 at 11-12px CJK is the difference between text that reads and text that looks thin
                 and hard. Blurring an empty rectangle costs the same and leaves the bar itself
                 un-rasterised. The same trick as ShellWindow's content host, for the same reason. -->
            <Border Background="{DynamicResource ToolbarBg}"
                    Margin="2"
                    CornerRadius="14">
                <Border.Effect>
                    <!-- Shadow color is black in both themes; hardcoded avoids Freezable binding edge cases.
                         Straight down rather than the default 315°, so the same margin serves the
                         left and right sides instead of one of them needing the offset too. -->
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                      Opacity="0.20" Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- ClearTypeHint on top of an opaque background: the window itself is layered
                 (AllowsTransparency), which is the other thing that turns ClearType off. The hint is
                 how WPF is told this particular surface really is opaque. -->
            <Border Background="{DynamicResource ToolbarBg}"
                    BorderBrush="{DynamicResource ToolbarBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8,8"
                    RenderOptions.ClearTypeHint="Enabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- At the head of the bar, in front of the source picker, because that picker is
                         what it reads with and what switches it off: this reads the original, never the
                         translation. Sat among the actions on the right it was one more thing to do to
                         the result, and the only way to say which text it meant would have been to spell
                         it out in the label — four characters for a button on a bar already short of
                         room. Position says it in none.

                         Reads the recognised source text as one piece, not block by block: the blocks
                         are how the picture was cut up for recognition, not how the sentence was
                         written, and read one at a time they come out as fragments. Same text the
                         translation window is opened with.

                         The one action here with no word under it. The rest of the bar keeps its
                         labels because none of those icons is standard enough to be read cold, but a
                         speaker and a stop square are — they are the same two shapes every media
                         control the user has ever pressed uses, and they say start and stop without
                         help. So the word came off and the bar got its width back. What the word was
                         doing besides naming the action, telling the user which text would be read,
                         it was never able to do anyway: 朗讀 alone does not say "the original", and
                         the button's position in front of the source picker does. The tooltip still
                         spells all of it out, and so does the name assistive technology reads —
                         see RenderSpeakButton. -->
                    <Button x:Name="TtsBtn"
                            Style="{StaticResource ToolbarTileButton}"
                            IsEnabled="False"
                            Margin="0,0,6,0"
                            Click="TtsBtn_Click">
                        <!-- Two points larger than the glyphs in the action row, because this one has
                             no name under it to carry half the weight: at the row's size it read as a
                             small mark rattling around inside its tile. -->
                        <TextBlock x:Name="TtsGlyph"
                                   Text="&#xE767;"
                                   Style="{StaticResource ToolbarActionGlyph}"
                                   FontSize="18"/>
                    </Button>

                    <!-- Source language. Width comes from SizeSelectorsToClosedLabels, not from here:
                         what these boxes show when closed depends on the interface language, and a
                         number typed in the markup is a guess about a string it cannot see. -->
                    <ComboBox x:Name="SrcLangBox"
                              Style="{StaticResource ToolbarComboBox}"
                              SelectedValuePath="Code"
                              VerticalContentAlignment="Center"/>

                    <!-- Swap -->
                    <Button Content="&#xE8AB;"
                            Style="{StaticResource ToolbarIconButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="14"
                            Margin="1,0"
                            ToolTip="{DynamicResource S.Toolbar.Swap}"
                            AutomationProperties.Name="{DynamicResource S.Toolbar.Swap}"
                            Click="SwapBtn_Click"/>

                    <!-- Target language -->
                    <ComboBox x:Name="TgtLangBox"
                              Style="{StaticResource ToolbarComboBox}"
                              ctl:ComboBoxSearch.IsEnabled="True"
                              Margin="0,0,6,0"
                              SelectedValuePath="Code"
                              VerticalContentAlignment="Center"/>

                    <!-- Provider -->
                    <ComboBox x:Name="ProviderBox"
                              Style="{StaticResource ToolbarComboBox}"
                              SelectedValuePath="Provider"
                              VerticalContentAlignment="Center"/>

                    <!-- Fallback badge: shown only when a backup engine actually served the batch -->
                    <Border x:Name="EngineBadge"
                            Visibility="Collapsed"
                            Background="#33F59E0B"
                            BorderBrush="#F59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="EngineBadgeText"
                                   Foreground="#F59E0B"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Which way the text in the selection is written. Last of the settings and hard
                         against the button that consumes it, because that is the order it is used in:
                         the user looks at a page of vertical Japanese, flips this, presses 翻譯. It is
                         deliberately not next to the source language picker, near though the two are in
                         meaning — that picker, the swap arrow and the target picker are one triple that
                         reads left to right, and dropping a control into the middle of it would cost
                         more than the adjacency gains.

                         Remembered between sessions because writing direction is normally a property
                         of the material someone is working through, not of one rectangle they drew.
                         A first run and every settings file from before this switch still start on
                         橫排; only an explicit press changes the stored answer.

                         The tray is the realtime bar's tray, for the same reason it has one: two
                         things the user chooses between are one control, not two more objects on a
                         crowded bar. -->
                    <!-- Centred rather than stretched. A child of a horizontal StackPanel defaults
                         to filling the panel's height, and the panel is now as tall as the stacked
                         actions at the far end - so this tray, which holds one 26px row, was being
                         pulled to 46 and reading as the tallest object on a bar where nothing beside
                         it is tall. -->
                    <Border Background="{DynamicResource ToolbarGroupBg}"
                            CornerRadius="10"
                            Padding="3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Grid.IsSharedSizeScope="True"
                            AutomationProperties.Name="{DynamicResource S.Toolbar.Direction}">
                        <Grid>
                            <!-- Shared, so the two halves are the width of the longer label rather
                                 than each their own — an even split is what makes the pill below able
                                 to travel one fixed distance, and it is what a two-way switch looks
                                 like. The labels are two characters each in Chinese and nothing like
                                 each other in English, so this cannot be a hardcoded width. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CaptureDirectionSegment"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="CaptureDirectionSegment"/>
                            </Grid.ColumnDefinitions>

                            <!-- The mark for the chosen half, behind both of them and slid between
                                 them rather than switched on and off. A marker that moves is the whole
                                 point: it carries the eye from the option that was chosen to the one
                                 that is now, which two backgrounds appearing and disappearing cannot
                                 do. See DirectionSegment_Checked for the motion. -->
                            <Border x:Name="DirectionThumb"
                                    Grid.Column="0"
                                    CornerRadius="7"
                                    Background="{DynamicResource ToolbarSegmentThumbBg}"
                                    BorderBrush="{DynamicResource ToolbarSegmentThumbBorder}"
                                    BorderThickness="1">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="DirectionThumbShift"/>
                                </Border.RenderTransform>
                            </Border>

                            <RadioButton x:Name="HorizontalSeg"
                                         Grid.Column="0"
                                         GroupName="CaptureTextDirection"
                                         IsChecked="True"
                                         Style="{StaticResource ToolbarSegmentButton}"
                                         ToolTip="{DynamicResource S.Toolbar.DirectionHorizontalHint}"
                                         PreviewMouseLeftButtonDown="DirectionSegment_PreviewMouseLeftButtonDown"
                                         Checked="DirectionSegment_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolbarSegmentGlyph}"
                                          Data="M2,3.5 H12 M2,7 H12 M2,10.5 H8"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{DynamicResource S.Toolbar.DirectionHorizontal}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="VerticalSeg"
                                         Grid.Column="1"
                                         GroupName="CaptureTextDirection"
                                         Style="{StaticResource ToolbarSegmentButton}"
                                         ToolTip="{DynamicResource S.Toolbar.DirectionVerticalHint}"
                                         PreviewMouseLeftButtonDown="DirectionSegment_PreviewMouseLeftButtonDown"
                                         Checked="DirectionSegment_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolbarSegmentGlyph}"
                                          Data="M10.5,2 V12 M7,2 V12 M3.5,2 V8"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{DynamicResource S.Toolbar.DirectionVertical}"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- Translate -->
                    <Button x:Name="TranslateBtn"
                            Style="{StaticResource ToolbarPrimaryButton}"
                            Margin="10,0,0,0"
                            Click="TranslateBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <!-- Drawn rather than typed: there is no sparkle in Segoe MDL2, which is all
                                 Windows 10 has, and a missing glyph on the primary button is the worst
                                 place for one. -->
                            <Path Width="13" Height="13"
                                  Stretch="None"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M7,0.6 C7.7,4.2 9.8,6.3 13.4,7 C9.8,7.7 7.7,9.8 7,13.4 C6.3,9.8 4.2,7.7 0.6,7 C4.2,6.3 6.3,4.2 7,0.6 Z M12.1,9.6 C12.3,10.8 12.6,11.1 13.8,11.3 C12.6,11.5 12.3,11.8 12.1,13 C11.9,11.8 11.6,11.5 10.4,11.3 C11.6,11.1 11.9,10.8 12.1,9.6 Z"/>
                            <TextBlock x:Name="TranslateLabel"
                                       VerticalAlignment="Center"
                                       Text="{DynamicResource S.Toolbar.Translate}"/>
                        </StackPanel>
                    </Button>

                    <!-- The bar is two halves and this is where they meet: everything left of the
                         rule is what the translation will be run with, everything right of it is
                         something to do once it has been. The gap alone used to say that, and it
                         stopped saying it once the right-hand half grew to five stacked actions -
                         against a run of five evenly spaced things, one wider gap is not a boundary,
                         it is a wider gap. Inset top and bottom so it reads as a mark on the bar
                         rather than as the bar being cut in two. -->
                    <Rectangle Width="1"
                               Margin="14,9,10,9"
                               Fill="{DynamicResource ToolbarDivider}"/>

                    <!-- Toggle original / translated bubbles -->
                    <Button x:Name="ToggleBtn"
                            Style="{StaticResource ToolbarStackButton}"
                            IsEnabled="False"
                            Click="ToggleBtn_Click">
                        <StackPanel>
                            <Grid Style="{StaticResource ToolbarActionIcon}">
                              <Grid Style="{StaticResource ToolbarActionDrawing}">
                                <!-- A whole eye, both lids. Segoe's E890 draws the upper lid and the
                                     pupil and nothing under them, which at 16px reads as an eyebrow
                                     over a dot rather than as an eye. -->
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M0.9,9 C3.3,5.1 5.9,3.2 9,3.2 C12.1,3.2 14.7,5.1 17.1,9
                                            C14.7,12.9 12.1,14.8 9,14.8 C5.9,14.8 3.3,12.9 0.9,9 Z"/>
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M11.5,9 A2.5,2.5 0 1 1 6.5,9 A2.5,2.5 0 1 1 11.5,9 Z"/>
                                <!-- The stroke through it, for while the original is the thing on
                                     screen: pressing then puts it away again. -->
                                <Path x:Name="ToggleHideSlash"
                                      Visibility="Collapsed"
                                      Style="{StaticResource ToolbarActionStroke}"
                                      Data="M2.4,15.6 L15.6,2.4"/>
                              </Grid>
                            </Grid>
                            <TextBlock x:Name="ToggleLabel"
                                       Text="{DynamicResource S.Toolbar.ShowSource}"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy the text currently represented by the selection. Before translation
                         this recognises the selection; afterwards it follows the source/translation
                         toggle and uses the result already held by the session. -->
                    <Button x:Name="CopyTextBtn"
                            Style="{StaticResource ToolbarStackButton}"
                            Click="CopyTextBtn_Click">
                        <StackPanel>
                            <Grid Style="{StaticResource ToolbarActionIcon}">
                              <Grid Style="{StaticResource ToolbarActionDrawing}">
                                <!-- The double-page outline stays fixed so both states still read
                                     as copy actions; only the meaning of the copied content changes. -->
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M6,4.7 H14.5 A1.5,1.5 0 0 1 16,6.2 V14.6 A1.5,1.5 0 0 1 14.5,16.1
                                            H6 A1.5,1.5 0 0 1 4.5,14.6 V6.2 A1.5,1.5 0 0 1 6,4.7 Z
                                            M4.5,13.3 H3.5 A1.5,1.5 0 0 1 2,11.8 V3.4 A1.5,1.5 0 0 1 3.5,1.9
                                            H12 A1.5,1.5 0 0 1 13.5,3.4 V4.7"/>
                                <Path x:Name="CopySourceMark"
                                      Style="{StaticResource ToolbarActionStroke}"
                                      Data="M7,8.2 H13.5 M7,10.6 H13.5 M7,13 H11.4"/>
                                <Path x:Name="CopyTranslationMark"
                                      Visibility="Collapsed"
                                      Style="{StaticResource ToolbarActionStroke}"
                                      Data="M6.9,14 L10.25,7 L13.6,14 M8.35,11 H12.15"/>
                              </Grid>
                            </Grid>
                            <TextBlock x:Name="CopyTextLabel"
                                       Text="{DynamicResource S.Toolbar.CopyText}"/>
                        </StackPanel>
                    </Button>

                    <!-- Draw on the selection. Between the two copies because that is the order
                         these are reached for: read the result, take the words, mark up what is left,
                         take the picture. Marking before the picture is also the only order that
                         makes sense of the picture - a screenshot taken after the marks has the
                         marks in it. -->
                    <Button x:Name="AnnotateBtn"
                            Style="{StaticResource ToolbarStackButton}"
                            ToolTip="{DynamicResource S.Toolbar.AnnotateHint}"
                            Click="AnnotateBtn_Click">
                        <StackPanel>
                            <Grid Style="{StaticResource ToolbarActionIcon}">
                              <Grid Style="{StaticResource ToolbarActionDrawing}">
                                <!-- A pen, nib down to the left, over the stroke it has just left
                                     behind. The mark matters as much as the pen does: a pen on its
                                     own is what every 編輯 button in the app already draws, and this
                                     one does not edit anything - it draws on top of what is there. -->
                                <!-- Sharpened to a point, and the cross line is where that point
                                     begins. The short end is the nib: put the line at the other
                                     end instead and it reads as a cap, which is the wrong end of
                                     the tool to be drawing attention to. -->
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M4.6,11.4 L5.16,7.44 L11.1,1.5 L14.5,4.9 L8.56,10.84 Z"/>
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M5.16,7.44 L8.56,10.84"/>
                                <!-- Level, and clear of the pen above it. Drawn on the same
                                     diagonal it was a second pen; level, it is the one thing in
                                     the picture that is not the tool, which is what makes it read
                                     as what the tool leaves behind. Heavier than the outlines
                                     around it, too, because it is ink and they are edges. -->
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      StrokeThickness="1.7"
                                      Data="M3.2,15.6 H15.4"/>
                              </Grid>
                            </Grid>
                            <TextBlock Text="{DynamicResource S.Toolbar.Annotate}"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy current selection screenshot to clipboard -->
                    <Button x:Name="CopyShotBtn"
                            Style="{StaticResource ToolbarStackButton}"
                            Click="CopyShotBtn_Click">
                        <StackPanel>
                            <Grid Style="{StaticResource ToolbarActionIcon}">
                              <Grid Style="{StaticResource ToolbarActionDrawing}">
                                <!-- Crop marks, not the copy glyph this used to wear. E8FF is two
                                     stacked pages, which is the same thing the copy button draws two
                                     places away - one row, two actions, one picture, and the only way
                                     to tell them apart was to read the words. A cropped frame says
                                     the one thing this action does that the other does not: it takes
                                     the rectangle, not the words inside it. -->
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M5.2,1.2 V12.8 H16.8 M1.2,5.2 H12.8 V16.8"/>
                              </Grid>
                            </Grid>
                            <TextBlock Text="{DynamicResource S.Toolbar.Screenshot}"/>
                        </StackPanel>
                    </Button>

                    <!-- Open translation window. Named for what it opens rather than for the opening:
                         every button on this bar does something when pressed, so 開啟 was a word spent
                         on the one thing the user already knows, and it cost the bar the width of two
                         characters. The tooltip still says the whole sentence for anyone who wants it. -->
                    <Button x:Name="OpenWindowBtn"
                            Style="{StaticResource ToolbarStackButton}"
                            ToolTip="{DynamicResource S.Toolbar.OpenWindowHint}"
                            Click="OpenWindowBtn_Click">
                        <StackPanel>
                            <Grid Style="{StaticResource ToolbarActionIcon}">
                              <Grid Style="{StaticResource ToolbarActionDrawing}">
                                <!-- Drawn like the other four rather than typed as E8A7, so the row
                                     is one set of strokes at one weight and one size. The glyph was
                                     the largest mark in the row and the drawn ones the smallest,
                                     which is the sort of difference nobody can name and everybody
                                     sees. -->
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M16,9.6 V14.4 A1.6,1.6 0 0 1 14.4,16 H3.6 A1.6,1.6 0 0 1 2,14.4
                                            V3.6 A1.6,1.6 0 0 1 3.6,2 H8.4"/>
                                <Path Style="{StaticResource ToolbarActionStroke}"
                                      Data="M9.4,8.6 L15.7,2.3 M11,2.2 H15.8 V7"/>
                              </Grid>
                            </Grid>
                            <TextBlock Text="{DynamicResource S.Toolbar.OpenWindow}"/>
                        </StackPanel>
                    </Button>

                    <!-- Close, set apart by the gap: everything left of it acts inside the session. -->
                    <Button Content="&#x2715;"
                            Style="{StaticResource ToolbarIconButton}"
                            Width="30" Height="30"
                            Margin="10,0,0,0"
                            ToolTip="{DynamicResource S.Toolbar.Close}"
                            AutomationProperties.Name="{DynamicResource S.Toolbar.Close}"
                            Click="CloseBtn_Click"/>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
