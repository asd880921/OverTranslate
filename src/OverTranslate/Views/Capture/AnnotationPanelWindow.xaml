<Window x:Class="OverTranslate.Views.Capture.AnnotationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- The same margin the capture toolbar leaves, and for the same reason: a blur still carrying
         opacity at the window's edge is cut off by a straight line, which reads as a stray border
         around the bar. The extra 8 on top is the caret's height. -->
    <Border Margin="12,18,12,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Points at the 標記 button that opened this. A panel that simply appears under a bar
                 belongs to the bar; one with a caret belongs to the button, and which button opened
                 it is the only thing about this panel that is not self-evident. Placed from code —
                 see PointCaretAt. -->
            <Canvas Grid.Row="0" ClipToBounds="False">
                <!-- Open at the base, and its base a pixel inside the bar. A closed triangle is
                     stroked all the way round, and the fourth stroke lands exactly where the
                     caret meets the bar — a line ruled across the join, which is the one place
                     there must not be one. Left open, the outline runs up one side and down the
                     other and stops, and the fill carries on under the bar's own edge. -->
                <Path x:Name="Caret"
                      Data="M0,9 L9,0.5 L18,9"
                      Fill="{DynamicResource ToolbarBg}"
                      Stroke="{DynamicResource ToolbarBorder}"
                      StrokeThickness="1"
                      StrokeLineJoin="Round"/>
            </Canvas>

            <Grid Grid.Row="1">
                <!-- Shadow on an empty twin rather than on the bar: an Effect rasterises the element
                     it is set on, and ClearType cannot run over a surface that may be transparent —
                     which at 11px CJK is the difference between a label that reads and one that
                     looks thin. Same trick the capture toolbar uses, for the same reason. -->
                <Border Background="{DynamicResource ToolbarBg}"
                        Margin="2"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                          Opacity="0.20" Color="#000000"/>
                    </Border.Effect>
                </Border>

                <Border Background="{DynamicResource ToolbarBg}"
                        BorderBrush="{DynamicResource ToolbarBorder}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="8,8"
                        RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- What a drag inside the box does. Three states of one control, so they are
                             one radio group: picking a tool is picking, not switching three things on
                             and off. -->
                        <ToggleButton x:Name="PenTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- The same pen the 標記 button on the bar above wears, to the
                                         point. The panel is that button opened up, and the tool it
                                         defaults to had better be the thing the button showed. -->
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M2.5,16.3 L3,11.85 L10.9,1.35 L14.55,4.1 L6.65,14.55 Z"/>
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M3,11.85 L6.65,14.55"/>
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M2.5,16.3 H15.5"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Pen}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="HighlighterTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- The pen's drawing told twice over: a fatter barrel, a nib cut
                                         square instead of sharpened, and a band under it instead of a
                                         line. Three differences saying one thing — this is the same
                                         gesture, laying down something broad and see-through. -->
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M2.8,10.6 L9.42,1.82 L14.22,5.43 L7.6,14.21 Z"/>
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M4.73,8.04 L9.53,11.65"/>
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          StrokeThickness="3"
                                          Data="M2.6,16 H15.4"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Highlighter}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="EraserTool"
                                      Style="{StaticResource ToolbarStackToggleButton}"
                                      Click="ToolBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- A block with a crease across it, resting flat on its own
                                         bottom edge — the one thing in the row that is not held at an
                                         angle, because it is the one that is pushed rather than
                                         drawn with. -->
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M5.6,15.6 L1.4,11.4 L9.2,3.6 L16.4,10.8 L11.6,15.6 Z"/>
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M5.3,7.5 L12.5,14.7"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Eraser}"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button x:Name="UndoBtn"
                                Style="{StaticResource ToolbarStackButton}"
                                Click="UndoBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M7,2.6 L2.6,7 L7,11.4 M2.6,7 H11 A4.4,4.4 0 0 1 11,15.8 H6.6"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Undo}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RedoBtn"
                                Style="{StaticResource ToolbarStackButton}"
                                Click="RedoBtn_Click">
                            <StackPanel>
                                <Grid Style="{StaticResource ToolbarActionIcon}">
                                  <Grid Style="{StaticResource ToolbarActionDrawing}">
                                    <!-- 復原 mirrored about the middle of the canvas, arc sweep and
                                         all. Two arrows that are not each other's reflection is the
                                         sort of thing nobody can name and everybody sees. -->
                                    <Path Style="{StaticResource ToolbarActionStroke}"
                                          Data="M11,2.6 L15.4,7 L11,11.4 M15.4,7 H7 A4.4,4.4 0 0 0 7,15.8 H11.4"/>
                                  </Grid>
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Annotate.Redo}"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1"
                                   Margin="14,9,10,9"
                                   Fill="{DynamicResource ToolbarDivider}"/>

                        <!-- Filled from code so the palette is one list in one place rather than
                             eight near-identical blocks of markup — see BuildPalette. -->
                        <StackPanel x:Name="Palette"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"/>

                        <Rectangle Width="1"
                                   Margin="12,9,12,9"
                                   Fill="{DynamicResource ToolbarDivider}"/>

                        <TextBlock Text="{DynamicResource S.Annotate.Thickness}"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <!-- One slider for all three tools, mapped onto each one's own range — see
                             ThicknessFor. A slider per tool would be three controls the user has to
                             discover are three, on a panel whose whole point is that it is small. -->
                        <Slider x:Name="ThicknessSlider"
                                Style="{StaticResource AppSlider}"
                                Width="110"
                                Minimum="0" Maximum="1"
                                SmallChange="0.1" LargeChange="0.25"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                ValueChanged="ThicknessSlider_ValueChanged"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
