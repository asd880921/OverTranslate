<Window x:Class="OverTranslate.Views.Capture.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <!-- Frozen screenshot as background -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- Semi-transparent dim layer; in background mode gets a hole cut for the selection -->
        <Path x:Name="DimPath" Fill="#80000000"/>

        <!-- Absolute-positioned canvas for selection rect -->
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="SelectionRect"
                       Stroke="#CC1E90D5"
                       StrokeThickness="2"
                       Visibility="Collapsed"
                       Fill="#5599C8F0"/>

            <Thumb x:Name="TopLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="TopLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="TopRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="TopRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="BottomLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="BottomRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Canvas>

        <!-- Info card, repeated once per monitor (see BuildHintSpots): on a multi-monitor desktop a
             single card sits on whichever screen holds the virtual desktop's top-left corner, which
             may not be the one the user is looking at. -->
        <ItemsControl x:Name="HintHost">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource AppCardBg}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="8,8,18,8">
                        <!-- Deeper than the app's usual card shadow on purpose: this one floats over
                             the user's frozen desktop, which is busy and unpredictable, so it needs
                             more separation than a card on a known background would. -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="2" Direction="270"
                                              Opacity="0.28" Color="#000000"/>
                        </Border.Effect>

                        <!-- No reveal animation, deliberately: the toolbar, the processing card and
                             the toast all appear instantly, and one element easing itself in reads
                             as an inconsistency rather than as polish. -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Leading position: before a selection exists this is the only
                                 clickable way out, so it reads first instead of trailing the copy. -->
                            <Button Content="✕"
                                    Style="{StaticResource IconButton}"
                                    VerticalAlignment="Center"
                                    ToolTip="取消截圖"
                                    Click="CancelCaptureBtn_Click"/>

                            <Rectangle Width="1" Height="34"
                                       Margin="8,0,14,0"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AppSeparator}"/>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Tracking is size-specific: the heading tightens slightly as it
                                     grows, the smaller line opens up a touch to stay legible. -->
                                <TextBlock Foreground="{DynamicResource AppTextPrimary}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="拖曳選取翻譯區域"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="按"/>

                                    <!-- Drawn as a keycap so the shortcut reads as a physical key
                                         rather than as prose. -->
                                    <Border Background="{DynamicResource AppButtonBg}"
                                            BorderBrush="{DynamicResource AppButtonBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Margin="5,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Text="ESC"/>
                                    </Border>

                                    <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                                               FontFamily="{StaticResource AppFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="取消"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
