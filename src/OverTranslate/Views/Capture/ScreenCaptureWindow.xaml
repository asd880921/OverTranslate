<Window x:Class="OverTranslate.Views.Capture.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <!-- Frozen screenshot as background -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- Semi-transparent dim layer; in background mode gets a hole cut for the selection -->
        <Path x:Name="DimPath" Fill="#80000000"/>

        <!-- Absolute-positioned canvas for selection rect -->
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="SelectionRect"
                       Stroke="#CC1E90D5"
                       StrokeThickness="2"
                       Visibility="Collapsed"
                       Fill="#5599C8F0"/>

            <Thumb x:Name="TopLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="TopLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="TopRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="TopRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="BottomLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="BottomRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Canvas>

        <!-- Info label -->
        <Border x:Name="InfoBorder"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.16" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Foreground="{DynamicResource AppTextPrimary}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="拖曳選取翻譯區域"/>
                <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           Margin="0,4,0,0"
                           Text="按 ESC 取消"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
