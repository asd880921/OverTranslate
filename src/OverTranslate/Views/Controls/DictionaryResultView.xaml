<UserControl x:Class="OverTranslate.Views.Controls.DictionaryResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="OptionalDictionaryText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DictionaryPartOfSpeechText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding PartOfSpeechLabel}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="ADJ">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Adjective}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="ADJECTIVE">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Adjective}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="ADV">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Adverb}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="ADVERB">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Adverb}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="ARTICLE">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Article}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="CONJ">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Conjunction}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="CONJUNCTION">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Conjunction}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="DET">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Determiner}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="DETERMINER">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Determiner}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="EXCLAMATION">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Interjection}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="INTERJECTION">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Interjection}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="MODAL">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.ModalVerb}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="NOUN">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Noun}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="PHRASE">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Phrase}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="PREP">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Preposition}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="PREPOSITION">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Preposition}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="PRON">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Pronoun}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="PRONOUN">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Pronoun}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="VERB">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Verb}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PartOfSpeechLabel}" Value="OTHER">
                    <Setter Property="Text" Value="{DynamicResource S.Dictionary.PartOfSpeech.Other}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="MessageText"
                   Visibility="Collapsed"
                   FontFamily="{StaticResource AppFont}"
                   FontSize="11"
                   Foreground="{DynamicResource AppTextSecondary}"
                   TextWrapping="Wrap"/>

        <StackPanel x:Name="ResultsPanel">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S.Dictionary.Alternatives}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextSecondary}"/>
                <TextBlock Text="{Binding Headword}"
                           Style="{StaticResource OptionalDictionaryText}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           Margin="8,0,0,0"/>
                <TextBlock Text="{Binding Pronunciation}"
                           Style="{StaticResource OptionalDictionaryText}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextSecondary}"
                           Margin="6,0,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource AppButtonHoverBg}"
                    CornerRadius="6"
                    Padding="7,3"
                    Margin="10,0,0,0">
                <TextBlock Text="{Binding Service}"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10"
                           Foreground="{DynamicResource AppTextSecondary}"/>
            </Border>
        </Grid>

        <ItemsControl ItemsSource="{Binding DisplayGroups}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource DictionaryPartOfSpeechText}"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccent}"
                                   Margin="0,0,0,5"/>

                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="4" Height="4"
                                                 Fill="{DynamicResource AppTextSecondary}"
                                                 Opacity="0.6"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Margin="1,8,0,0"/>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Text}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimary}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Transliteration}"
                                                           Style="{StaticResource OptionalDictionaryText}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondary}"
                                                           Margin="7,3,0,0"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding BackTranslationsText}"
                                                       Style="{StaticResource OptionalDictionaryText}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>

                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        </StackPanel>
    </StackPanel>
</UserControl>
