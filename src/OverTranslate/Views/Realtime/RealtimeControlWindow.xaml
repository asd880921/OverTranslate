<Window x:Class="OverTranslate.Views.Realtime.RealtimeControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outer margin leaves room for the shadow to render outside the visual. The LayoutTransform is
         set in code: this window is pinned onto a screen that may not be the one WPF laid it out
         for, and on a mixed-DPI desktop that means it would otherwise come out the wrong physical
         size. Same correction the capture toolbar and the processing card already apply. -->
    <Border x:Name="RootChrome"
            Margin="10,8,10,12"
            MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
            MouseMove="Chrome_MouseMove"
            MouseLeftButtonUp="Chrome_MouseLeftButtonUp">
        <Border x:Name="Chrome"
                Background="{DynamicResource ToolbarBg}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="10,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.22" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- ══════════ Edit mode ══════════ -->
                <!-- Everything the user needs while framing sits on one line: what to do, how many
                     blocks they have left, and the one way forward. -->
                <StackPanel x:Name="EditPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="4,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppAccent}"
                               Text="&#xE7A7;"/>

                    <TextBlock x:Name="EditHintText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12.5"
                               Foreground="{DynamicResource AppTextPrimary}"
                               Text="在螢幕上拖曳建立要翻譯的區塊"/>

                    <!-- Muted and trailing: a running count is a reference, not an instruction -->
                    <TextBlock x:Name="BlockCountText"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextMuted}"/>

                    <Separator Style="{StaticResource VerticalSeparator}"/>

                    <Button x:Name="StartBtn"
                            Content="開始翻譯"
                            Style="{StaticResource ToolbarAccentButton}"
                            Margin="0,0,4,0"
                            Click="StartBtn_Click"/>

                    <Button Content="✕"
                            Style="{StaticResource ToolbarIconButton}"
                            ToolTip="結束即時翻譯"
                            Click="CloseBtn_Click"/>
                </StackPanel>

                <!-- ══════════ Translating ══════════ -->
                <!-- Shrunk to a capsule once the work starts: from here on the interface has nothing
                     to ask, and the user is watching the content, not this. -->
                <StackPanel x:Name="RunPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Margin="4,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource AppAccent}"/>

                    <TextBlock x:Name="RunStatusText"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12.5"
                               Foreground="{DynamicResource AppTextPrimary}"
                               Text="即時翻譯中"/>

                    <Button Content="編輯"
                            Style="{StaticResource ToolbarFlatButton}"
                            Margin="0,0,4,0"
                            Click="EditBtn_Click"/>

                    <Button Content="✕"
                            Style="{StaticResource ToolbarIconButton}"
                            ToolTip="結束即時翻譯"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
