<UserControl x:Class="OverTranslate.Views.Realtime.RealtimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Page header ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource S.Realtime.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource S.Realtime.Subtitle}"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel MaxWidth="760">

                <!-- ── 翻譯設定 ── -->
                <!-- Labels above their fields, as on 圖片翻譯: a fixed label column makes the
                     longest label decide the layout, and these read down the page rather than
                     across. -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Realtime.TranslationSettings}" Style="{StaticResource SectionHeader}"/>

                        <!-- OCR source languages only: this page recognises text off the screen, so
                             a language the recogniser cannot read has nothing to offer here. Left
                             unset on purpose — see RealtimePage.ApplyPageDefaults. -->
                        <TextBlock Text="{DynamicResource S.Realtime.SourceLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <!-- Placeholder rather than a line of help underneath: the field is empty
                             because the user has to answer it, and saying so inside the empty space
                             puts the instruction where they are already looking. Margin matches the
                             selected item's own (9,0,28,0) so the prompt and the eventual answer
                             occupy the same spot rather than shifting when one replaces the other. -->
                        <Grid Margin="0,0,0,14">
                            <ComboBox x:Name="SrcLangBox"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectedValuePath="Code"/>
                            <TextBlock x:Name="SrcLangPlaceholder"
                                       Text="{DynamicResource S.Realtime.SourceLanguagePrompt}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="{StaticResource AppFontSize}"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="9,0,28,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource S.Realtime.TargetLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="TgtLangBox"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedValuePath="Code"
                                  Margin="0,0,0,14"/>

                        <!-- Grouped so the spacing below stays the same whether or not the chosen
                             service has anything to warn about -->
                        <TextBlock Text="{DynamicResource S.Realtime.Provider}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <StackPanel>
                            <ComboBox x:Name="ProviderBox"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectedValuePath="Provider"/>
                            <TextBlock x:Name="ProviderHint"
                                       Style="{StaticResource FieldHint}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 區塊設定 ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Realtime.Blocks}" Style="{StaticResource SectionHeader}"/>

                        <!-- One screen per session, chosen here rather than assumed: the primary
                             monitor is not where the game or the video necessarily is. -->
                        <TextBlock Text="{DynamicResource S.Realtime.Screen}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScreenBox"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedValuePath="DeviceName"/>
                        <TextBlock Text="{DynamicResource S.Realtime.ScreenHint}"
                                   Style="{StaticResource FieldHint}"
                                   Margin="0,6,0,14" TextWrapping="Wrap" LineHeight="16"/>

                        <!-- A stepper rather than a text field: the value is one of three, and a
                             box that accepts typing invites 0, 99 and empty, each of which then
                             needs its own rule. The number is display-only and the two buttons are
                             the only way in, so no input can be wrong. -->
                        <TextBlock Text="{DynamicResource S.Realtime.BlockCount}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource StepperBorder}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BlockCountDown"
                                        Style="{StaticResource StepperButton}"
                                        Content="&#xE949;"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.DecreaseBlocks}"
                                        Click="BlockCountDown_Click"/>
                                <TextBlock x:Name="BlockCountText"
                                           Style="{StaticResource StepperValue}"
                                           Text="1"/>
                                <Button x:Name="BlockCountUp"
                                        Style="{StaticResource StepperButton}"
                                        Content="&#xE948;"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.IncreaseBlocks}"
                                        Click="BlockCountUp_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource S.Realtime.BlockCountHint}"
                                   Style="{StaticResource FieldHint}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- ── 顯示外觀 ── -->
                <!-- The one card on this page whose values are kept — see the class remarks for the
                     rule that separates these from the session parameters above. -->
                <!-- Four groups, one per kind of decision: what it will look like, the two colours,
                     how heavy the band is, and the two effects that are off until asked for. The
                     card held all of them in one column before, which read as one long list of
                     unrelated controls; grouping is what tells the reader that the slider belongs to
                     the colour above it and not to the switches below. -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Realtime.Appearance}" Style="{StaticResource SectionHeader}"/>

                        <!-- Preview first, above the controls that feed it. A session hides the
                             shell window, so this is the last moment the user can see their colours
                             together — after 選取翻譯區塊 there is no way back to this page without
                             ending the session. -->
                        <Border Style="{StaticResource InnerGroupBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Realtime.Preview}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <!-- Checkered rather than filled: what is behind the band is a game
                                     or a video this page cannot know, and a chequerboard says that
                                     where a flat colour quietly claimed to be it. The two greys are
                                     fixed in both themes — see TransparencyChecker for why. -->
                                <Border x:Name="PreviewBackdrop"
                                        Height="72"
                                        CornerRadius="4"
                                        Background="{StaticResource TransparencyChecker}"
                                        ClipToBounds="True">
                                    <Border x:Name="PreviewScrim"
                                            CornerRadius="3"
                                            Padding="14,6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="PreviewText"
                                                   Text="{DynamicResource S.Realtime.PreviewText}"
                                                   FontFamily="Microsoft JhengHei, Segoe UI Variable Text, Segoe UI, Sans-Serif"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- The two colours and the undo that acts on both, on one row: they are the
                             same kind of thing said three ways, and stacking them made this taller
                             than the settings it holds. The labels sit above their own control so
                             they stay put however wide the hex text gets, and the divider says which
                             label belongs to which swatch without a second border. -->
                        <Border Style="{StaticResource InnerGroupBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="{DynamicResource S.Realtime.TextColor}"
                                           Style="{StaticResource FieldLabel}" Margin="2,0,0,6"/>
                                <Button Grid.Column="0" Grid.Row="1"
                                        x:Name="TextColorBtn"
                                        Style="{StaticResource FlatButton}"
                                        Height="34"
                                        Padding="6,0"
                                        Click="TextColorBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TextColorSwatch"
                                                Width="20" Height="20"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TextColorValue"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,6,0"/>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0"/>
                                    </StackPanel>
                                </Button>

                                <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                                        Width="1"
                                        Margin="16,2,16,2"
                                        Background="{DynamicResource AppSubtleBorder}"/>

                                <TextBlock Grid.Column="2" Grid.Row="0" Text="{DynamicResource S.Realtime.ScrimColor}"
                                           Style="{StaticResource FieldLabel}" Margin="2,0,0,6"/>
                                <Button Grid.Column="2" Grid.Row="1"
                                        x:Name="ScrimColorBtn"
                                        Style="{StaticResource FlatButton}"
                                        Height="34"
                                        Padding="6,0"
                                        Click="ScrimColorBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ScrimColorSwatch"
                                                Width="20" Height="20"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ScrimColorValue"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,6,0"/>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- Labelled now rather than icon-only: it sits at the far end of a
                                     wide row, where a lone glyph is a guess. Still on the controls'
                                     row rather than under a label of its own, because it acts on
                                     both of them instead of being a third setting. Available only
                                     once something has been changed — a reset that would do nothing
                                     still looks like it might, and the user has to press it to
                                     find out. -->
                                <Button Grid.Column="4" Grid.Row="0" Grid.RowSpan="2"
                                        x:Name="ResetColorsBtn"
                                        Style="{StaticResource IconButton}"
                                        Width="Auto"
                                        Height="32"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource S.Realtime.ResetColors}"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.ResetColorsName}"
                                        Click="ResetColorsBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S.Common.Reset}"
                                                   VerticalAlignment="Center"
                                                   Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Label, slider and number on one line. The slider is the one control here
                             the user sets by watching something else — the preview above is what
                             tells them when the band is right — so it gets the whole width that is
                             left, and the number keeps a fixed column so the track does not shift
                             under the thumb as the value goes from 7% to 72%. -->
                        <Border Style="{StaticResource InnerGroupBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource S.Realtime.ScrimOpacity}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="2,0,16,0"/>
                                <Slider Grid.Column="1"
                                        x:Name="ScrimOpacitySlider"
                                        Style="{StaticResource AppSlider}"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.ScrimOpacity}"
                                        ValueChanged="ScrimOpacitySlider_ValueChanged"/>
                                <TextBlock Grid.Column="2"
                                           x:Name="ScrimOpacityValue"
                                           Style="{StaticResource FieldLabel}"
                                           MinWidth="42"
                                           TextAlignment="Right"
                                           Margin="16,0,2,0"/>
                            </Grid>
                        </Border>

                        <!-- Off until asked for, both of them, which is why they are a group of
                             their own rather than two more controls above: everything above this
                             describes a band the user chose the colours of, and everything in here
                             replaces part of that with something read off the screen. -->
                        <Border Style="{StaticResource InnerGroupBorder}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Realtime.AdvancedOptions}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>

                                <Border Style="{StaticResource ToggleRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE91B;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource S.Realtime.NaturalBackground}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource AppFontSize}"
                                                       Foreground="{DynamicResource AppTextPrimary}"/>
                                            <TextBlock Text="{DynamicResource S.Realtime.NaturalBackgroundHint}"
                                                       Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  x:Name="NaturalBackgroundToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Margin="14,0,2,0"
                                                  AutomationProperties.Name="{DynamicResource S.Realtime.NaturalBackground}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ToggleRowBorder}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xEF3C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="2,0,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource S.Realtime.SampleTextColor}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="{StaticResource AppFontSize}"
                                                       Foreground="{DynamicResource AppTextPrimary}"/>
                                            <TextBlock Text="{DynamicResource S.Realtime.SampleTextColorHint}"
                                                       Style="{StaticResource FieldHint}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2"
                                                  x:Name="SampleTextColorToggle"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Margin="14,0,2,0"
                                                  AutomationProperties.Name="{DynamicResource S.Realtime.SampleTextColor}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Outside the group rather than inside it: it is not a third option, it is
                             what both of the two above cost. -->
                        <Grid Margin="4,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE946;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="0,3,7,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource S.Realtime.AdvancedOptionsCost}"
                                       Style="{StaticResource FieldHint}"
                                       Margin="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 運作方式 ── -->
                <!-- Four lines, because the on-screen half of this feature is a mode the user has
                     not seen before: what the button does, what happens next, the one property that
                     is not obvious from looking at it (the blocks do not take the mouse), and the
                     way to put the overlays away for a scene without giving up the blocks. -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Realtime.HowItWorks}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,6"
                                   Text="{DynamicResource S.Realtime.Step1}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,6"
                                   Text="{DynamicResource S.Realtime.Step2}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16"
                                   Text="{DynamicResource S.Realtime.Step3}"/>
                        <!-- Filled in by RenderPauseHint, which names the user's own shortcut and
                             drops the line entirely when they have cleared it. Its top margin sits
                             on this line rather than under the one above, so a hidden hint does not
                             leave a gap at the bottom of the card. -->
                        <TextBlock x:Name="PauseHint"
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ── -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
            <Button x:Name="PrimaryBtn"
                    Content="{DynamicResource S.Realtime.SelectBlocks}"
                    Style="{StaticResource AccentButton}"
                    Height="36" MinWidth="140" Padding="16,0"
                    DockPanel.Dock="Left"
                    Margin="0,0,14,0"
                    Click="PrimaryBtn_Click"/>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="12"
                       Foreground="{DynamicResource AppTextSecondary}"/>
        </DockPanel>
    </Grid>
</UserControl>
