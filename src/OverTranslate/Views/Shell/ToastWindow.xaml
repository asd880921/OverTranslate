<Window x:Class="OverTranslate.Views.Shell.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="320"
        SizeToContent="Height">

    <!-- Margin leaves room for the shadow to render outside the visual -->
    <Border Margin="8,6,8,10">
        <Border Background="{DynamicResource ToastBg}"
                CornerRadius="10"
                BorderBrush="{DynamicResource ToastBorder}"
                BorderThickness="1">
            <!-- Matches the toolbar and hint card: this floats over the user's own screen content,
                 so it needs a shadow to read as a separate layer rather than a painted rectangle. -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status stripe: the only thing distinguishing a success from a failure at a
                     glance. Colour is assigned in code from the ToastKind. -->
                <Rectangle x:Name="AccentBar"
                           Grid.Column="0"
                           Width="3"
                           RadiusX="1.5" RadiusY="1.5"
                           Margin="8,10,0,10"/>

                <Grid Grid.Column="1" Margin="12,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource ToastTitle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>

                        <!-- Same icon button as the toolbar and hint card, so it behaves the way
                             every other icon button in the app does (hover fill, pressed state). -->
                        <Button Grid.Column="1"
                                Content="⧉"
                                Style="{StaticResource ToolbarIconButton}"
                                VerticalAlignment="Top"
                                Margin="0,-4,-4,0"
                                ToolTip="複製訊息"
                                Click="CopyButton_Click"/>
                    </Grid>

                    <!-- MESSAGE -->
                    <TextBlock Grid.Row="1"
                               x:Name="MessageText"
                               FontSize="12"
                               Foreground="{DynamicResource ToastMessage}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="2"
                               x:Name="CopyHint"
                               Text="已複製到剪貼簿"
                               FontSize="11"
                               Foreground="{DynamicResource AppSuccess}"
                               Visibility="Collapsed"
                               Margin="0,6,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
