<Window x:Class="OverTranslate.Views.Shell.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="320"
        SizeToContent="Height">

    <!-- At least the blur radius on every side, plus the offset below — see the comment on the
         effect. Short of that the blur is cut off by the window's edge, and the cut is a straight
         line: a faint grey rectangle around the toast. -->
    <Border Margin="14,12,14,16">
        <Border Background="{DynamicResource ToastBg}"
                CornerRadius="10"
                BorderBrush="{DynamicResource ToastBorder}"
                BorderThickness="1">
            <!-- Matches the toolbar and hint card: this floats over the user's own screen content,
                 so it needs a shadow to read as a separate layer rather than a painted rectangle. -->
            <Border.Effect>
                <!-- Straight down rather than the default 315°, so the same margin serves the left
                     and right sides instead of one of them needing the offset too. -->
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                  Opacity="0.20" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status stripe: the only thing distinguishing a success from a failure at a
                     glance. Colour is assigned in code from the ToastKind. -->
                <Rectangle x:Name="AccentBar"
                           Grid.Column="0"
                           Width="3"
                           RadiusX="1.5" RadiusY="1.5"
                           Margin="8,10,0,10"/>

                <Grid Grid.Column="1" Margin="12,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Grid Grid.Row="0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource ToastTitle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,4"/>

                        <!-- Same icon buttons as the toolbar and hint card, so they behave the way
                             every other icon button in the app does (hover fill, pressed state).
                             Close sits rightmost, where Windows puts it on every other surface. -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="0,-5,-6,0">
                            <Button Content="⧉"
                                    Style="{StaticResource ToastIconButton}"
                                    ToolTip="{DynamicResource S.Toast.CopyMessage}"
                                    Click="CopyButton_Click"/>

                            <!-- A hair smaller: ✕ carries more ink than ⧉ at the same point size,
                                 and the two must read as one pair rather than two weights. -->
                            <Button Content="✕"
                                    Style="{StaticResource ToastIconButton}"
                                    FontSize="11"
                                    ToolTip="{DynamicResource S.Common.Close}"
                                    Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- MESSAGE -->
                    <TextBlock Grid.Row="1"
                               x:Name="MessageText"
                               FontSize="12"
                               Foreground="{DynamicResource ToastMessage}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>

                    <TextBlock Grid.Row="2"
                               x:Name="CopyHint"
                               Text="{DynamicResource S.Toast.Copied}"
                               FontSize="11"
                               Foreground="{DynamicResource AppSuccess}"
                               Visibility="Collapsed"
                               Margin="0,6,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
