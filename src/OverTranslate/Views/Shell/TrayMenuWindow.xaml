<Window x:Class="OverTranslate.Views.Shell.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="FontFamily"                 Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="Foreground"                 Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Height"                     Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="4,1"
                                Padding="10,0">
                            <!-- Stretch so an item can push a trailing hint to the right edge -->
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- At least the blur radius on every side, plus the offset below. Short of that the blur is
         cut off by the window's edge and the cut shows: a straight grey line around the menu. -->
    <Grid Margin="18">
        <Border CornerRadius="8"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                Padding="0,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                  Opacity="0.24" Color="#000000"/>
            </Border.Effect>

            <StackPanel Width="196">

                <!-- 截圖翻譯 is deliberately absent: it lives on the shell window's nav rail and on
                     the shortcut. Three entry points for one action was one too many, and this menu
                     is the one that has to stay short as the app grows. -->

                <!-- 開啟翻譯視窗；即時翻譯進行中改為把浮動視窗列移至最上層 -->
                <Button x:Name="OpenWindowBtn"
                        Style="{StaticResource TrayMenuItem}"
                        Click="OpenWindowBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OpenWindowIcon"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE737;"
                                   Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="OpenWindowLabel" Text="{DynamicResource S.Tray.OpenWindow}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 設定 -->
                <Button x:Name="SettingsBtn"
                        Style="{StaticResource TrayMenuItem}"
                        Click="SettingsBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE713;"
                                   Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock Text="{DynamicResource S.Tray.Settings}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Height="1" Margin="8,3" Fill="{DynamicResource AppSeparator}"/>

                <!-- 結束 -->
                <Button x:Name="ExitBtn"
                        Style="{StaticResource TrayMenuItem}"
                        Click="ExitBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE8BB;"
                                   Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock Text="{DynamicResource S.Tray.Exit}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
