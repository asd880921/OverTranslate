<Window x:Class="OverTranslate.Views.QuickTranslate.QuickTranslateHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="360"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- The toast's buttons at the size this surface can carry. A hint is a line of text tall,
             so the 28px controls that suit a toast would set the height of the whole thing and turn
             a remark into a panel. -->
        <Style x:Key="HintIconButton" TargetType="Button" BasedOn="{StaticResource ToastIconButton}">
            <Setter Property="Width"    Value="22"/>
            <Setter Property="Height"   Value="22"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <!-- At least the blur radius on every side, plus the offset below — the same margin the toast
         carries, and for the same reason: short of it the blur is cut off by the window's edge and
         the cut reads as a faint grey rectangle around the card. -->
    <Border Margin="14,12,14,16">
        <Border x:Name="Card"
                Background="{DynamicResource ToastBg}"
                CornerRadius="10"
                BorderBrush="{DynamicResource ToastBorder}"
                BorderThickness="1">
            <!-- Dark in both themes and floating over the user's own window, exactly as the toast
                 is: this is the same kind of momentary remark, and two different-looking answers to
                 that would be two things for the reader to learn. -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                  Opacity="0.20" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The application's own way of saying "working", at the size this card can spare.
                     Inset from the sides rather than run to the edges: the card's corners are
                     rounded and a bar squared off against them would show its own two corners. -->
                <ProgressBar x:Name="WorkingBar"
                             Grid.Row="0"
                             Height="2"
                             Margin="10,0,10,0"
                             IsIndeterminate="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource AppAccent}"/>

                <Grid Grid.Row="1" Margin="12,8,6,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Carries the outcome on its own, for the glance that is all this gets: the
                         reader has already turned back to their text. Absent while the bar above is
                         still running, because there is no outcome yet to name. -->
                    <TextBlock x:Name="StatusGlyph"
                               Grid.Column="0"
                               Text="&#xE73E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Margin="0,0,7,0"/>

                    <TextBlock x:Name="MessageText"
                               Grid.Column="1"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource ToastTitle}"
                               TextWrapping="Wrap"
                               MaxHeight="60"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <!-- Close sits rightmost, where Windows puts it on every other surface. Both
                         stay in place through every state so the card never changes shape under a
                         pointer that is on its way to one of them. -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button x:Name="CopyBtn"
                                Content="&#xE8C8;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource HintIconButton}"
                                ToolTip="{DynamicResource S.Toast.CopyMessage}"
                                Click="CopyButton_Click"/>

                        <Button Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource HintIconButton}"
                                ToolTip="{DynamicResource S.Common.Close}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
