<Window x:Class="OverTranslate.Views.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False">
    <Grid>
        <!-- Every layer here says it cannot be hit, and the window itself says so too. Only the
             drawing surface below ever takes it back, and only while 標記 is on: without these the
             bubbles — which do have backgrounds — would swallow the pointer the moment the window
             became hit-testable, and the one place the user most wants to draw on is over a bubble. -->

        <!-- Translation backgrounds and text are separated so no later bubble background can cover prior text. -->
        <Canvas x:Name="BubbleBackgroundCanvas" IsHitTestVisible="False"/>
        <Canvas x:Name="BubbleTextCanvas" IsHitTestVisible="False"/>

        <!-- What a drag inside the selection is drawn onto. A rectangle rather than the canvas
             itself, sized and placed onto the selection, because that is what confines the gesture
             to the box: an empty Canvas is not hit-testable at all, and one given a background would
             be hit-testable across the whole desktop. Shown only while 標記 is on.

             #01000000 and not Transparent, the same near-invisible fill RealtimeEditWindow's canvas
             uses and for the same reason: this window is layered, and Windows hit-tests a layered
             window against its composited alpha before any message is delivered. A fully
             transparent brush paints alpha 0, so the click falls straight through to whatever is
             underneath and the surface never hears about it. One step off zero is enough, and
             nothing on screen can tell the difference.

             Worth knowing when reading this: WPF's own hit test says the surface was hit either
             way — VisualTreeHelper.HitTest returns it with a fully transparent fill — so this
             cannot be found by asking WPF. It is decided a layer below. -->
        <Canvas x:Name="AnnotationInputCanvas">
            <Rectangle x:Name="AnnotationSurface"
                       Fill="#01000000"
                       Visibility="Collapsed"
                       MouseLeftButtonDown="AnnotationSurface_MouseLeftButtonDown"
                       MouseMove="AnnotationSurface_MouseMove"
                       MouseLeftButtonUp="AnnotationSurface_MouseLeftButtonUp"
                       MouseLeave="AnnotationSurface_MouseLeave"/>
        </Canvas>

        <!-- The marks themselves, above the translation: someone annotating after a translation is
             marking up what they can see, and half of what they can see is the bubbles. Clipped to
             the selection — see SetAnnotationBounds. -->
        <Canvas x:Name="AnnotationCanvas" IsHitTestVisible="False"/>

        <!-- The eraser's own pointer: a ring the size of the circle it will rub out, so what is
             about to go is visible before it goes. Its own layer above the ink, and deliberately not
             one of the layers 截圖 renders — see RenderOverlayForSelection — because it is a pointer,
             not a mark. -->
        <Canvas x:Name="AnnotationCursorCanvas" IsHitTestVisible="False">
            <Ellipse x:Name="EraserRing"
                     Visibility="Collapsed"
                     Stroke="#FFFFFFFF"
                     StrokeThickness="1.5"
                     Fill="#1FFFFFFF"/>
        </Canvas>

        <!-- Processing indicator — separate layer so it's always above bubbles -->
        <Canvas x:Name="IndicatorCanvas" IsHitTestVisible="False">
            <Border x:Name="ProcessingBorder"
                    Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,12"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.2" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AppAccentSubtle}" Margin="0,0,10,0">
                        <Viewbox Margin="4">
                            <Path x:Name="ProcessingSpinner"
                                  Fill="{DynamicResource AppAccent}"
                                  Data="M 8,0 A 8,8 0 1 1 0,8 L 2.2,8 A 5.8,5.8 0 1 0 8,2.2 Z"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Path.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Viewbox>
                    </Border>
                    <TextBlock Foreground="{DynamicResource AppTextPrimary}"
                               x:Name="ProcessingText"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{DynamicResource S.Overlay.Recognising}"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
