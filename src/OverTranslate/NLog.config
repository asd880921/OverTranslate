<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <!-- Debug and below stay out of the shipped log: that level carries the recognised text, which is
       whatever happened to be on the user's screen. Set OVERTRANSLATE_LOGLEVEL=Debug to record the
       full detail while reproducing a problem; autoReload above means editing this file works too. -->
  <variable name="minLevel" value="${environment:OVERTRANSLATE_LOGLEVEL:whenEmpty=Info}"/>

  <targets>
    <!-- Beside the settings file in Roaming AppData, not under the install directory: Velopack
         installs each version into its own folder, so a log written next to the executable is lost
         on the very update the user is most likely to be reporting a problem about. -->
    <target xsi:type="File"
            name="file"
            fileName="${specialfolder:folder=ApplicationData}/OverTranslate/logs/app.log"
            archiveFileName="${specialfolder:folder=ApplicationData}/OverTranslate/logs/app.{###}.log"
            archiveNumbering="Rolling"
            archiveEvery="Day"
            archiveAboveSize="2097152"
            maxArchiveFiles="5"
            layout="${longdate} [${level:uppercase=true}] ${logger:shortName=true} — ${message}${onexception:${newline}EXCEPTION\: ${exception:format=toString}}"
            keepFileOpen="true"
            encoding="utf-8" />

    <target xsi:type="Debugger"
            name="debug"
            layout="${time} [${level:uppercase=true}] ${logger:shortName=true} — ${message}${onexception: | ${exception:format=message}}" />
  </targets>

  <rules>
    <logger name="OverTranslate.*" minlevel="${var:minLevel}" writeTo="file,debug" />
    <!-- Warnings and above for everything else -->
    <logger name="*" minlevel="Warn" writeTo="file,debug" />
  </rules>

</nlog>
