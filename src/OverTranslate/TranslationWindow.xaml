<Window x:Class="OverTranslate.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverTranslate 翻譯視窗"
        Width="860" Height="540"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource AppWindowBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppHeaderBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel VerticalAlignment="Center">

                <!-- Settings button — auto width avoids text clipping from fixed Width -->
                <Button DockPanel.Dock="Right"
                        Content="設定"
                        Style="{StaticResource FlatButton}"
                        Padding="14,0"
                        Height="30"
                        Click="SettingsBtn_Click"/>

                <!-- Language / provider selectors -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SrcLangBox"
                              Style="{StaticResource ModernComboBox}"
                              Width="162" Height="30" Margin="0,0,6,0"
                              SelectedValuePath="Code"
                              VerticalContentAlignment="Center"/>

                    <Button Content="⇄"
                            Style="{StaticResource IconButton}"
                            Width="30" Height="30" Margin="0,0,6,0"
                            FontSize="13"
                            Click="SwapBtn_Click"/>

                    <ComboBox x:Name="TgtLangBox"
                              Style="{StaticResource ModernComboBox}"
                              Width="162" Height="30" Margin="0,0,6,0"
                              SelectedValuePath="Code"
                              VerticalContentAlignment="Center"/>

                    <ComboBox x:Name="ProviderBox"
                              Style="{StaticResource ModernComboBox}"
                              Width="148" Height="30"
                              SelectedValuePath="Provider"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Split content area ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{DynamicResource AppHeaderBg}"
                        BorderBrush="{DynamicResource AppSubtleBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="14,5">
                    <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right"
                                x:Name="SrcTtsBtn"
                                Content="🔊"
                                Width="34" Height="28" Padding="0"
                                Style="{StaticResource FlatButton}"
                                ToolTip="朗讀原文"
                                Click="SrcTtsBtn_Click"/>
                        <TextBlock Text="原文"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Sans-Serif"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextMuted}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TextBox Grid.Row="1"
                         x:Name="SourceTextBox"
                         Style="{StaticResource MultilineTextBox}"
                         Background="{DynamicResource AppSurfaceBg}"/>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource AppSplitter}"
                          ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <!-- Right panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{DynamicResource AppHeaderBg}"
                        BorderBrush="{DynamicResource AppSubtleBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="14,5">
                    <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right"
                                x:Name="TgtTtsBtn"
                                Content="🔊"
                                Width="34" Height="28" Padding="0"
                                Style="{StaticResource FlatButton}"
                                ToolTip="朗讀譯文"
                                Click="TgtTtsBtn_Click"/>
                        <TextBlock Text="譯文"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Sans-Serif"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextMuted}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Indeterminate bar: visible only while an auto-translation is in flight -->
                <ProgressBar Grid.Row="1"
                             x:Name="TranslatingBar"
                             Height="3"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource AppAccent}"/>

                <TextBox Grid.Row="2"
                         x:Name="TranslatedTextBox"
                         Style="{StaticResource MultilineTextBox}"
                         IsReadOnly="True"
                         Background="{DynamicResource AppWindowBg}"/>
            </Grid>
        </Grid>

        <!-- ── Footer bar ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppHeaderBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel VerticalAlignment="Center">
                <!-- Retry surfaces only when an auto-translate fails (no permanent translate button) -->
                <Button x:Name="RetryBtn"
                        Content="↻ 重試"
                        Style="{StaticResource FlatButton}"
                        Height="30" Padding="14,0"
                        DockPanel.Dock="Left"
                        Visibility="Collapsed"
                        Margin="0,0,12,0"
                        Click="RetryBtn_Click"/>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI, Sans-Serif"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
