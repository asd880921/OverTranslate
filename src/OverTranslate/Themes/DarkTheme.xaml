<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / Surface -->
    <SolidColorBrush x:Key="AppWindowBg"       Color="#202020"/>
    <SolidColorBrush x:Key="AppSurfaceBg"      Color="#2C2C2C"/>
    <SolidColorBrush x:Key="AppHeaderBg"       Color="#1C1C1C"/>
    <SolidColorBrush x:Key="AppCardBg"         Color="#252525"/>
    <SolidColorBrush x:Key="AppBorder"         Color="#3C3C3C"/>
    <SolidColorBrush x:Key="AppSubtleBorder"   Color="#303030"/>

    <!-- A note the reader is not being asked to act on, laid over AppCardBg. A lift rather than a
         dip: it has to read as a panel on top of the card, and AppAccentSubtle — which this used
         first — is darker than the card it sits on and carries far more colour than a sentence
         needs. The cast that is left says "informational" without competing with the accent that
         marks things the reader can press. -->
    <SolidColorBrush x:Key="AppInfoBg"         Color="#2A3037"/>

    <!-- Text — two levels, and there is no third. AppTextMuted (#666666) was removed: against the
         surfaces it was used on it reached 2.4:1, under the 4.5:1 any text needs and under even the
         3:1 for non-text, so none of its seven uses were legible — least of all the ones on the
         realtime bar, which floats over whatever the user is watching. Anything subordinate is made
         subordinate by size, weight and position instead; those cost no contrast. -->
    <SolidColorBrush x:Key="AppTextPrimary"    Color="#F0F0F0"/>
    <SolidColorBrush x:Key="AppTextSecondary"  Color="#AAAAAA"/>

    <!-- Accent -->
    <!-- A step deeper than the #60CDFF this used to be. The accent is filled into large flat areas
         here — a switch track, a checked box — and a light colour spread over one reads lighter than
         the same colour does as a word or as a hairline, so the on state came out looking washed
         rather than on. One token rather than a second brush for the filled case: the places that
         draw with it are the same places, and a second blue to keep in step with the first is the
         kind of pair that drifts. Kept to a small step so the accent stays legible where it is text
         on a dark ground, which is the other half of what it does. Pressed follows it down, or it
         would no longer read as darker than the resting state it answers. -->
    <SolidColorBrush x:Key="AppAccent"         Color="#52C4FA"/>
    <SolidColorBrush x:Key="AppAccentHover"    Color="#7AD7FF"/>
    <SolidColorBrush x:Key="AppAccentPressed"  Color="#3EB2E6"/>
    <SolidColorBrush x:Key="AppAccentFg"       Color="#000000"/>

    <!-- The knob of a switch that is on. White in both themes rather than AppAccentFg,
         which is what text on the accent needs: the knob is not text on the track, it is the
         thing that moved, and a dark one reads as a hole in a light track. -->
    <SolidColorBrush x:Key="AppToggleKnobOn"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppAccentSubtle"   Color="#1A2E3D"/>

    <!-- Interaction steps for AppAccentSubtle, for tonal surfaces that stay tonal on hover instead
         of flipping to the solid accent — a full-width nav card is far too large a area to flood
         with accent on mouse-over the way a 28px toolbar button can. -->
    <SolidColorBrush x:Key="AppAccentSubtleHover"   Color="#213B4E"/>
    <SolidColorBrush x:Key="AppAccentSubtlePressed" Color="#152634"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="AppButtonBg"       Color="#333333"/>
    <SolidColorBrush x:Key="AppButtonBorder"   Color="#484848"/>
    <SolidColorBrush x:Key="AppButtonHoverBg"  Color="#404040"/>
    <SolidColorBrush x:Key="AppButtonPressedBg" Color="#4A4A4A"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="AppInputBg"        Color="#2C2C2C"/>
    <SolidColorBrush x:Key="AppInputBorder"    Color="#484848"/>
    <SolidColorBrush x:Key="AppInputFocusBorder" Color="#60CDFF"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="AppSplitter"       Color="#383838"/>
    <SolidColorBrush x:Key="AppSuccess"        Color="#6CCB5F"/>
    <SolidColorBrush x:Key="AppError"          Color="#FF6B6B"/>
    <!-- Not an error: a service that has not been given its key yet still works once it is,
         so it must not be painted the colour a failure is. -->
    <SolidColorBrush x:Key="AppWarning"        Color="#E8A33D"/>
    <SolidColorBrush x:Key="AppWarningSubtle"  Color="#3A2E1C"/>

    <!-- Translation service marks: white on this ground, black on the light theme's.
         See DeepLMarkGeometry in SharedStyles. -->
    <SolidColorBrush x:Key="AppDeepLMark"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppOpenAiMark"     Color="#FFFFFF"/>

    <!-- The app's own mark, straight from icons/icon-glyph.svg — on this ground the plate is what
         the file intends and the brand cyan carries. See LightTheme.xaml for why that theme
         does not take these values as they are. -->
    <SolidColorBrush x:Key="AppGlyphPlate"     Color="#0D1117"/>
    <SolidColorBrush x:Key="AppGlyphField"     Color="#081018"/>
    <SolidColorBrush x:Key="AppGlyphInk"       Color="#60EFFF"/>
    <SolidColorBrush x:Key="AppGlyphPlateEdge" Color="#33434E"/>
    <SolidColorBrush x:Key="AppSectionHeader"  Color="#BBBBBB"/>

    <!-- Toolbar specific -->
    <SolidColorBrush x:Key="ToolbarBg"         Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ToolbarBorder"     Color="#484848"/>

    <!-- The primary action on a floating toolbar. Its own blue rather than AppAccent, for the one
         place the accent cannot serve: this bar is dark in the dark theme, and there AppAccent is a
         pale cyan that takes black text — correct Fluent for a filled button on a page, a bright
         patch shouting off a bar that floats over whatever the user is actually looking at. A blue
         deep enough to carry white text sits on the bar instead of on top of it. In the light theme
         the accent already is that blue and already carries white, so there it is the accent. -->
    <SolidColorBrush x:Key="ToolbarPrimaryBg"        Color="#3B82F6"/>
    <SolidColorBrush x:Key="ToolbarPrimaryHoverBg"   Color="#5693F8"/>
    <SolidColorBrush x:Key="ToolbarPrimaryPressedBg" Color="#2F6FE0"/>
    <SolidColorBrush x:Key="ToolbarPrimaryFg"        Color="#FFFFFF"/>

    <!-- The action group on the realtime edit bar: a slightly raised tray holding the two buttons the
         user chooses between, so they read as one control rather than as more window furniture. Its
         buttons need their own hover and pressed steps because the bar's are measured against the
         bar, and against this tray they would be all but invisible. -->
    <SolidColorBrush x:Key="ToolbarGroupBg"        Color="#363636"/>
    <SolidColorBrush x:Key="ToolbarGroupHoverBg"   Color="#464646"/>
    <SolidColorBrush x:Key="ToolbarGroupPressedBg" Color="#505050"/>
    <Color x:Key="ToolbarShadowColor"          >#000000</Color>

    <!-- Toast — same in both themes (always dark) -->
    <SolidColorBrush x:Key="ToastBg"           Color="#E8202020"/>
    <SolidColorBrush x:Key="ToastBorder"       Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ToastTitle"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastMessage"      Color="#CCCCCC"/>
    <!-- Icon buttons sit on the dark toast, never on the window background, so they cannot use the
         themed button brushes: in Light those resolve to dark-on-dark glyphs and a white hover. -->
    <SolidColorBrush x:Key="ToastIconFg"        Color="#AAFFFFFF"/>
    <SolidColorBrush x:Key="ToastIconFgHover"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastIconHoverBg"   Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ToastIconPressedBg" Color="#33FFFFFF"/>

    <!-- Separator -->
    <SolidColorBrush x:Key="AppSeparator"      Color="#383838"/>

    <!-- Scrollbar — track uses alpha so it reads correctly over both
         AppSurfaceBg (#2C2C2C) and AppWindowBg (#202020) panes -->
    <SolidColorBrush x:Key="AppScrollThumb"        Color="#5A5A5A"/>
    <SolidColorBrush x:Key="AppScrollThumbHover"   Color="#9D9D9D"/>
    <SolidColorBrush x:Key="AppScrollThumbPressed" Color="#BFBFBF"/>
    <SolidColorBrush x:Key="AppScrollTrack"        Color="#14FFFFFF"/>

</ResourceDictionary>
