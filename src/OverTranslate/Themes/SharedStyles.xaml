<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!--  FONTS / SIZES                              -->
    <!-- ═══════════════════════════════════════════ -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Sans-Serif</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="AppFontSize">13</sys:Double>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SECTION HEADER                             -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppSectionHeader}"/>
        <Setter Property="Margin"      Value="0,0,0,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  FIELD LABEL                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"          Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,12,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  FIELD HINT                                 -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"     Value="11"/>
        <Setter Property="Foreground"   Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Margin"       Value="2,3,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CARD BORDER                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppCardBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="16,12"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  INNER GROUP BORDER                         -->
    <!--  A group inside a card: same rounding, no   -->
    <!--  fill of its own, so nesting one inside a   -->
    <!--  card reads as grouping rather than as a    -->
    <!--  second card that happens to be smaller.    -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="InnerGroupBorder" TargetType="Border">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TOGGLE ROW BORDER                          -->
    <!--  One switchable option inside a group: an   -->
    <!--  icon, a name, a line of explanation and a  -->
    <!--  switch. Filled rather than outlined, so a  -->
    <!--  row reads as one clickable thing next to   -->
    <!--  the group that holds it.                   -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ToggleRowBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppSurfaceBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Margin"          Value="0,0,0,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  INFO CARD BORDER                           -->
    <!--  A note the reader is not being asked to    -->
    <!--  act on. Tinted with the accent rather than -->
    <!--  outlined like the groups around it, so it  -->
    <!--  reads as information at a glance instead   -->
    <!--  of as one more control that happens to     -->
    <!--  hold sentences.                            -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="InfoCardBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppInfoBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Margin"          Value="0,0,0,14"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CARD HEADER ICON                           -->
    <!--  The glyph in front of a card's heading.    -->
    <!--  Accent-coloured so the headings can be     -->
    <!--  found by shape when the page is a grid of  -->
    <!--  cards rather than one column to read down. -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="CardHeaderIcon" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"          Value="18"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppAccent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,9,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CARD TITLE                                 -->
    <!--  What a card is about. A size up from       -->
    <!--  SectionHeader and in the primary colour,   -->
    <!--  because on a page laid out as a grid of    -->
    <!--  cards these are the landmarks the reader   -->
    <!--  navigates by; SectionHeader stays as it is -->
    <!--  for the sub-headings inside a card.        -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize"          Value="15"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TRANSLATION SERVICE MARKS                  -->
    <!--                                             -->
    <!--  Transcribed from the vendors' own SVGs in  -->
    <!--  icons/openai and icons/deepl — WPF has no  -->
    <!--  SVG loader, and the path data is the whole -->
    <!--  of these files. Re-transcribe rather than  -->
    <!--  redraw if a vendor ships a new mark.       -->
    <!--                                             -->
    <!--  Sized by width in the tiles, not height:    -->
    <!--  DeepL's mark is narrow and tall and         -->
    <!--  OpenAI's is square, so equal heights make   -->
    <!--  the DeepL one the smaller of the two. The   -->
    <!--  width is set against a fixed square that    -->
    <!--  paints nothing — see the tiles: Uniform     -->
    <!--  only shrinks to fit, so without a bounded   -->
    <!--  height a small geometry stays at its own    -->
    <!--  size, which is 19 units for DeepL.          -->
    <!--                                              -->
    <!--  F1 is the nonzero fill rule the SVGs use;   -->
    <!--  WPF geometry defaults to even-odd, which   -->
    <!--  would punch the wrong holes in both.       -->
    <!--                                             -->
    <!--  OpenAI ships a black mark and a white one -->
    <!--  and gets whichever the theme calls for;    -->
    <!--  DeepL ships one drawn in currentColor and  -->
    <!--  is meant to take the colour it is given.   -->
    <!--  Either way the fill is the theme's         -->
    <!--  AppDeepLMark / AppOpenAiMark, never an     -->
    <!--  accent — a mark recoloured to a palette is -->
    <!--  no longer the mark.                        -->
