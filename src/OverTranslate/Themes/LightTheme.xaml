<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window / Surface -->
    <SolidColorBrush x:Key="AppWindowBg"       Color="#F3F3F3"/>
    <SolidColorBrush x:Key="AppSurfaceBg"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppHeaderBg"       Color="#F5F5F5"/>
    <SolidColorBrush x:Key="AppCardBg"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBorder"         Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AppSubtleBorder"   Color="#EBEBEB"/>

    <!-- The light-theme half of AppInfoBg — see DarkTheme.xaml. Tinted rather than lifted here,
         because the card underneath is already white and there is nothing above it to lift to. -->
    <SolidColorBrush x:Key="AppInfoBg"         Color="#EDF5FC"/>

    <!-- Text — two levels, and there is no third. See DarkTheme for why AppTextMuted was removed;
         its light value (#999999) was 2.75:1, no better. -->
    <SolidColorBrush x:Key="AppTextPrimary"    Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AppTextSecondary"  Color="#5A5A5A"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AppAccent"         Color="#0078D4"/>
    <SolidColorBrush x:Key="AppAccentHover"    Color="#106EBE"/>
    <SolidColorBrush x:Key="AppAccentPressed"  Color="#005A9E"/>
    <SolidColorBrush x:Key="AppAccentFg"       Color="#FFFFFF"/>

    <!-- The knob of a switch that is on. White in both themes rather than AppAccentFg,
         which is what text on the accent needs: the knob is not text on the track, it is the
         thing that moved, and a dark one reads as a hole in a light track. -->
    <SolidColorBrush x:Key="AppToggleKnobOn"   Color="#FFFFFF"/>
    <!-- ~13% AppAccent over white. The old #EEF4FF was mixed against #FFFFFF and works there, but
         its heaviest duty is the nav rail's selected row, which sits on AppHeaderBg #F5F5F5 — only
         7 levels of red and 1 of green away from it, so the selection all but vanished. Dark has no
         such problem (#1A2E3D on #1C1C1C separates by 33 levels of blue), which is why only this
         theme moves. -->
    <SolidColorBrush x:Key="AppAccentSubtle"   Color="#DEEDFB"/>

    <!-- Interaction steps for AppAccentSubtle, for tonal surfaces that stay tonal on hover instead
         of flipping to the solid accent — a full-width nav card is far too large an area to flood
         with accent on mouse-over the way a 28px toolbar button can. -->
    <SolidColorBrush x:Key="AppAccentSubtleHover"   Color="#CFE4F8"/>
    <SolidColorBrush x:Key="AppAccentSubtlePressed" Color="#BFD9F4"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="AppButtonBg"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppButtonBorder"   Color="#D1D1D1"/>
    <SolidColorBrush x:Key="AppButtonHoverBg"  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="AppButtonPressedBg" Color="#E5E5E5"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="AppInputBg"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppInputBorder"    Color="#C8C8C8"/>
    <SolidColorBrush x:Key="AppInputFocusBorder" Color="#0078D4"/>

    <!-- Misc -->
    <SolidColorBrush x:Key="AppSplitter"       Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AppSuccess"        Color="#0F7B0F"/>
    <SolidColorBrush x:Key="AppError"          Color="#C42B1C"/>
    <SolidColorBrush x:Key="AppSectionHeader"  Color="#444444"/>

    <!-- Toolbar specific -->
    <SolidColorBrush x:Key="ToolbarBg"         Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ToolbarBorder"     Color="#D0D0D0"/>
    <Color x:Key="ToolbarShadowColor"          >#000000</Color>

    <!-- Toast — same in both themes (always dark) -->
    <SolidColorBrush x:Key="ToastBg"           Color="#E8202020"/>
    <SolidColorBrush x:Key="ToastBorder"       Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ToastTitle"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastMessage"      Color="#CCCCCC"/>
    <!-- Icon buttons sit on the dark toast, never on the window background, so they cannot use the
         themed button brushes: in Light those resolve to dark-on-dark glyphs and a white hover. -->
    <SolidColorBrush x:Key="ToastIconFg"        Color="#AAFFFFFF"/>
    <SolidColorBrush x:Key="ToastIconFgHover"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToastIconHoverBg"   Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="ToastIconPressedBg" Color="#33FFFFFF"/>

    <!-- Separator -->
    <SolidColorBrush x:Key="AppSeparator"      Color="#E0E0E0"/>

    <!-- Scrollbar — track uses alpha so it reads correctly over both
         AppSurfaceBg (white) and AppWindowBg (grey) panes -->
    <SolidColorBrush x:Key="AppScrollThumb"        Color="#C2C2C2"/>
    <SolidColorBrush x:Key="AppScrollThumbHover"   Color="#8A8A8A"/>
    <SolidColorBrush x:Key="AppScrollThumbPressed" Color="#5F5F5F"/>
    <SolidColorBrush x:Key="AppScrollTrack"        Color="#0A000000"/>

</ResourceDictionary>
