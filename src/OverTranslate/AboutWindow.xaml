<Window x:Class="OverTranslate.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="關於 OverTranslate"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBg}">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App Name & Version -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="OverTranslate"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
            <TextBlock Text="作者 Hon.Lu (asd880921)"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="12"
                       Foreground="{DynamicResource AppTextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Description -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="一款適合你的 Windows 螢幕翻譯工具"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="按下快捷鍵、框選任意畫面區域，翻譯結果直接浮現在原位。支援多種翻譯引擎與 OCR，適用於遊戲介面、PDF、影片字幕等任何無法選取的文字。"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- GitHub Link -->
        <Button Grid.Row="2"
                Style="{StaticResource FlatButton}"
                Height="36"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0"
                Click="GitHubBtn_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Text="&#xE774;"
                           Width="22" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondary}"/>
                <TextBlock Text="在 GitHub 上查看原始碼" VerticalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
