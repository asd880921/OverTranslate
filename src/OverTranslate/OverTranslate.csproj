<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icons\icon_256.ico</ApplicationIcon>
    <StartupObject>OverTranslate.App</StartupObject>
    <Version>2.0.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WFAC010 tells WinForms apps to declare DPI awareness through Application.SetHighDpiMode.
         This is a WPF app that only references WinForms types; ApplicationConfiguration.Initialize
         is never called, so the manifest is the only mechanism that takes effect. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="ocrmodels\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="icons\icon_32.ico" />
    <EmbeddedResource Include="icons\icon_256.ico" />
    <Resource Include="icons\capture_crosshair.cur" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GTranslate" Version="2.3.1" />
    <PackageReference Include="NLog" Version="5.0.4" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" ExcludeAssets="build" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
